From: Stanislaw Pal <kuncy7@gmail.com>
Subject: [DEBUG v2] mtd/spinand: pinpoint the -512 probe failure

RESOLVED (2026-08-09, thread post #443): the -512 came from the qpic
ECC chip-requirement fallback path ("trying 4-bits") failing on the
DEFERRED re-probe. Pinning the ECC config in the board DTS
(nand-ecc-strength = <4>; nand-ecc-step-size = <512>;) avoids the
fallback entirely and the board boots. This patch is a diagnostic tool
only - do not apply it as a fix; it stays here for reference.

Debug-only, not for merging. Round 2: the first log showed -512 is born
inside spinand_init() on the deferred re-probe, so this version prints
the return value of every step inside spinand_init()/spinand_init_flash()
as well (read_cfg, upd_cfg, configure_chip, per-target select/unlock,
nanddev_init, ECC engine init, OTP ops, OOB freebytes), on top of the
round-1 probe/mtd instrumentation. Same usage: drop it into
target/linux/generic/pending-6.18/999-debug-spinand.patch and rebuild.

--- a/drivers/mtd/mtdcore.c	2026-08-09 13:08:22.929977201 +0200
+++ b/drivers/mtd/mtdcore.c	2026-08-09 13:08:22.938977362 +0200
@@ -1023,6 +1023,7 @@
 		size = mtd_otp_size(mtd, true);
 		if (size < 0) {
 			err = size;
+			pr_err("DBG otp: user mtd_otp_size err=%d\n", err);
 			goto err;
 		}
 
@@ -1031,6 +1032,7 @@
 						       mtd_nvmem_user_otp_reg_read);
 			if (IS_ERR(nvmem)) {
 				err = PTR_ERR(nvmem);
+				pr_err("DBG otp: user nvmem_register err=%d\n", err);
 				goto err;
 			}
 			mtd->otp_user_nvmem = nvmem;
@@ -1041,6 +1043,7 @@
 		size = mtd_otp_size(mtd, false);
 		if (size < 0) {
 			err = size;
+			pr_err("DBG otp: fact mtd_otp_size err=%d\n", err);
 			goto err;
 		}
 
@@ -1060,6 +1063,7 @@
 			err = mtd_nvmem_fact_otp_reg_read(mtd, 0, otp, size);
 			if (err < 0) {
 				kfree(otp);
+				pr_err("DBG otp: fact reg_read err=%d\n", err);
 				goto err;
 			}
 			add_device_randomness(otp, err);
@@ -1069,6 +1073,7 @@
 						       mtd_nvmem_fact_otp_reg_read);
 			if (IS_ERR(nvmem)) {
 				err = PTR_ERR(nvmem);
+				pr_err("DBG otp: fact nvmem_register err=%d\n", err);
 				goto err;
 			}
 			mtd->otp_factory_nvmem = nvmem;
@@ -1123,8 +1128,10 @@
 	mtd_set_dev_defaults(mtd);
 
 	ret = mtd_otp_nvmem_add(mtd);
-	if (ret)
+	if (ret) {
+		pr_err("DBG mtd_otp_nvmem_add ret=%d\n", ret);
 		goto out;
+	}
 
 	if (IS_ENABLED(CONFIG_MTD_PARTITIONED_MASTER)) {
 		ret = add_mtd_device(mtd);
@@ -1134,6 +1141,8 @@
 
 	/* Prefer parsed partitions over driver-provided fallback */
 	ret = parse_mtd_partitions(mtd, types, parser_data);
+	if (ret < 0)
+		pr_err("DBG parse_mtd_partitions ret=%d\n", ret);
 	if (ret == -EPROBE_DEFER)
 		goto out;
 
