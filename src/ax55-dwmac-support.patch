-# (first boot / initramfs), then enable every radio as a WPA2 AP on lan.
-[ -f /etc/config/wireless ] || /sbin/wifi config
+# NOTE: the WiFi AP is NOT configured here. ath11k loads its firmware
+# asynchronously and only registers the radios ~14s into boot, well after
+# uci-defaults run (~10s), so doing it here would find no PHYs. It is handled
+# instead by /etc/hotplug.d/ieee80211/25-ax55-wifi, which fires exactly when
+# each radio registers (SSID OpenWrt-AX55 / key ax55test).
 
-. /lib/functions.sh
-config_load wireless
-
