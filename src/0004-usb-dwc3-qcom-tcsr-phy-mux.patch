From: Stanisław Pal <kuncy7@gmail.com>
Date: Mon, 6 Jul 2026 00:00:00 +0200
Subject: [PATCH] usb: dwc3: qcom: support the TCSR USB phy mux (IPQ5018)

On IPQ5018 the USB pads sit behind a PHY mux controlled from a TCSR
register. The vendor (QSDK) dwc3-qcom driver selects the USB position by
writing 1 there ("usb phy mux sel", qcom,phy-mux-regs); without it, on
boards whose bootloader never touches USB (e.g. TP-Link Archer AX55 v1),
the port stays muxed away and no device ever enumerates. Port the vendor
property/behaviour as an optional DT hook.

Signed-off-by: Stanisław Pal <kuncy7@gmail.com>
---
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -22,6 +22,8 @@
 #include <linux/iopoll.h>
 #include <linux/usb/hcd.h>
 #include <linux/usb.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
 #include "core.h"
 
 /* USB QSCRATCH Hardware registers */
@@ -730,6 +732,37 @@
 	return ret;
 }
 
+/*
+ * Some IPQ SoCs (e.g. IPQ5018) route the USB pads through a PHY mux
+ * controlled from a TCSR register; the bootloader does not necessarily
+ * select the USB position. Optional "qcom,phy-mux-regs" = <&tcsr offset>
+ * points at it; the vendor driver writes 1 ("usb phy mux sel") there.
+ */
+static int dwc3_qcom_setup_phy_mux(struct dwc3_qcom *qcom)
+{
+	struct of_phandle_args args;
+	struct regmap *map;
+	int ret;
+
+	ret = of_parse_phandle_with_fixed_args(qcom->dev->of_node,
+					       "qcom,phy-mux-regs", 1, 0,
+					       &args);
+	if (ret)
+		return 0;	/* optional */
+
+	map = syscon_node_to_regmap(args.np);
+	of_node_put(args.np);
+	if (IS_ERR(map))
+		return dev_err_probe(qcom->dev, PTR_ERR(map),
+				     "failed to map phy mux regs\n");
+
+	ret = regmap_write(map, args.args[0], 0x1);
+	if (ret)
+		dev_err(qcom->dev, "failed to select USB phy mux: %d\n", ret);
+
+	return ret;
+}
+
 static int dwc3_qcom_probe(struct platform_device *pdev)
 {
 	struct device_node	*np = pdev->dev.of_node;
@@ -793,6 +826,10 @@
 	if (ignore_pipe_clk)
 		dwc3_qcom_select_utmi_clk(qcom);
 
+	ret = dwc3_qcom_setup_phy_mux(qcom);
+	if (ret)
+		goto clk_disable;
+
 	ret = dwc3_qcom_of_register_core(pdev);
 	if (ret) {
 		dev_err(dev, "failed to register DWC3 Core, err=%d\n", ret);
