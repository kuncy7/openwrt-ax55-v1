diff --git a/target/linux/qualcommax/patches-6.12/0918-net-dsa-realtek-rtl8365mb-add-sgmii-hsgmii-support.patch b/target/linux/qualcommax/patches-6.12/0918-net-dsa-realtek-rtl8365mb-add-sgmii-hsgmii-support.patch
new file mode 100644
index 0000000000..dc921510bc
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0918-net-dsa-realtek-rtl8365mb-add-sgmii-hsgmii-support.patch
@@ -0,0 +1,604 @@
+From: OpenWrt
+Date: Tue, 7 Jul 2026 20:00:00 +0200
+Subject: [PATCH] net: dsa: realtek: rtl8365mb: add SGMII and HSGMII support
+
+The mainline rtl8365mb driver only configures RGMII on the extension
+interface, so switches such as the RTL8367S that are connected to the SoC
+over a (2.5G) SGMII/HSGMII link cannot be brought up (phylink_mac_config
+is a no-op for non-RGMII and SGMII/2500BASEX are not advertised).
+
+Add SGMII and HSGMII (advertised as 2500BASE-X) support for extension
+interface 1. The SerDes calibration tables are taken from the GPL-2.0
+Realtek vendor driver that already lives in OpenWrt's mediatek target
+(rtl8367c_setAsicPortExtMode). Unlike the vendor driver, no 8051 SerDes
+firmware is needed: the vendor firmware acts as a runtime babysitter for
+the SerDes, and bring-up works without it as long as the SerDes in-band
+SGMII autoneg is disabled and the link parameters are forced (verified
+on hardware: full 2.5G trunk operation, NAT throughput included).
+
+The SDS_MISC force bits (link/speed/duplex/pause) and the SGMII in-band
+autoneg disable are both mandatory - each alone leaves a link-up trunk
+that passes no traffic (verified live on AX55 hardware).
+
+This is a re-derivation of Hauke Mehrtens' 2022 netdev series, minus the
+firmware blob whose licensing blocked it back then.
+
+Needed for the TP-Link Archer AX55 v1 (IPQ5018 + RTL8367S).
+
+Rebased onto the v7.2 backports (942-xx) that split rtl8365mb.c into
+rtl8365mb.c and rtl8365mb_l2.c.
+
+Signed-off-by: OpenWrt <noreply@openwrt.org>
+---
+
+Cold-boot reliability: poll the SDS status from the CPU port MIB work: verify the
+SerDes RX is locked (SDS status 0x3D) and pulse the vendor's
+SerDes reset from the CPU port MIB poll until it does - this replaces the 8051 firmware's
+babysitter loop for the one case where it matters.
+
+--- a/drivers/net/dsa/realtek/rtl8365mb.c
++++ b/drivers/net/dsa/realtek/rtl8365mb.c
+@@ -207,6 +207,38 @@
+ #define RTL8365MB_EXT_PORT_MODE_1000X_100FX	11
+ #define RTL8365MB_EXT_PORT_MODE_1000X		12
+ #define RTL8365MB_EXT_PORT_MODE_100FX		13
++/* Registers used to bring up the (H)SGMII extension interface. The
++ * RTL8365MB_MAGIC_REG/RTL8365MB_MAGIC_VALUE, RTL8365MB_CHIP_VER_REG and
++ * RTL8365MB_CHIP_RESET_REG defines already exist above and are reused here.
++ */
++#define RTL8365MB_OPTION_MAGIC_REG		0x13C0
++#define RTL8365MB_OPTION_REG			0x13C1
++
++#define RTL8365MB_MISC_CFG0_REG			0x130C
++#define   RTL8365MB_MISC_CFG0_DW8051_EN_MASK	0x0020
++
++#define   RTL8365MB_CHIP_RESET_DW8051_MASK	0x0010
++
++#define RTL8365MB_DW8051_RDY_REG		0x1336
++#define   RTL8365MB_DW8051_RDY_ACS_IROM_MASK	0x0002
++#define   RTL8365MB_DW8051_RDY_IROM_MSB_MASK	0x0004
++#define RTL8365MB_DW8051_IRAM_BASE		0xE000
++
++#define RTL8365MB_SDS_MISC_REG			0x1D11
++#define   RTL8365MB_SDS_MISC_MAC8_SGMII_MASK	0x0040
++#define   RTL8365MB_SDS_MISC_MAC8_HSGMII_MASK	0x0800
++#define   RTL8365MB_SDS_MISC_SGMII_RXFC_MASK	0x4000
++#define   RTL8365MB_SDS_MISC_SGMII_TXFC_MASK	0x2000
++#define   RTL8365MB_SDS_MISC_SGMII_FDUP_MASK	0x0400
++#define   RTL8365MB_SDS_MISC_SGMII_LINK_MASK	0x0200
++#define   RTL8365MB_SDS_MISC_SGMII_SPD_MASK	0x0180
++
++#define RTL8365MB_SDS_INDACS_CMD_REG		0x6600
++#define   RTL8365MB_SDS_INDACS_CMD_WRITE	0x00C0
++#define   RTL8365MB_SDS_INDACS_CMD_READ		0x0080
++#define RTL8365MB_SDS_INDACS_ADR_REG		0x6601
++#define RTL8365MB_SDS_INDACS_DATA_REG		0x6602
++
+ 
+ /* External interface mode configuration registers 0~1 */
+ #define RTL8365MB_DIGITAL_INTERFACE_SELECT_REG0		0x1305 /* EXT0,EXT1 */
+@@ -645,6 +677,16 @@ struct rtl8365mb {
+ 	struct rtl8365mb_cpu cpu;
+ 	struct mutex mib_lock;
+ 	struct rtl8365mb_port ports[RTL8365MB_MAX_NUM_PORTS];
++	/* SerDes RX "babysitter" state (see rtl8365mb_ext_sgmii_nanny) */
++	bool sds_nanny;
++	int sds_port;
++	int sds_pulses;
++	int sds_bad_polls;
++	u64 sds_last_crc;
++	u64 sds_last_rx;
++	u64 sds_last_conduit_tx;
++	u64 sds_last_seen;
++	phy_interface_t sds_interface;
+ };
+ 
+ static int rtl8365mb_phy_poll_busy(struct realtek_priv *priv)
+@@ -948,6 +990,7 @@ static int rtl8365mb_ext_config_rgmii(st
+ }
+ 
+ static int rtl8365mb_ext_config_forcemode(struct realtek_priv *priv, int port,
++					  phy_interface_t interface,
+ 					  bool link, int speed, int duplex,
+ 					  bool tx_pause, bool rx_pause)
+ {
+@@ -970,7 +1013,7 @@ static int rtl8365mb_ext_config_forcemod
+ 		r_rx_pause = rx_pause ? 1 : 0;
+ 		r_tx_pause = tx_pause ? 1 : 0;
+ 
+-		if (speed == SPEED_1000) {
++		if (speed == SPEED_2500 || speed == SPEED_1000) {
+ 			r_speed = RTL8365MB_PORT_SPEED_1000M;
+ 		} else if (speed == SPEED_100) {
+ 			r_speed = RTL8365MB_PORT_SPEED_100M;
+@@ -1015,9 +1058,416 @@ static int rtl8365mb_ext_config_forcemod
+ 	if (ret)
+ 		return ret;
+ 
++	/*
++	 * For the SGMII/HSGMII extension interface the digital-interface
++	 * force register above is not enough: the SerDes MAC link (speed/
++	 * duplex/link/pause) must also be forced in the SDS_MISC register,
++	 * exactly as the vendor rtl8367c setAsicPortForceLinkExt() does for
++	 * ext id 1. Without this the link is reported up but the trunk
++	 * passes no traffic in either direction (verified live on the AX55:
++	 * setting the LINK bit by hand instantly brought DHCP up).
++	 */
++	if (interface == PHY_INTERFACE_MODE_SGMII ||
++	    interface == PHY_INTERFACE_MODE_2500BASEX) {
++		u32 sds_mask = RTL8365MB_SDS_MISC_SGMII_RXFC_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_TXFC_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_FDUP_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_LINK_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_SPD_MASK;
++		u32 sds_val =
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_RXFC_MASK, r_rx_pause) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_TXFC_MASK, r_tx_pause) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_FDUP_MASK, r_duplex) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_LINK_MASK, r_link) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_SPD_MASK, r_speed);
++
++		ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
++					 sds_mask, sds_val);
++		if (ret)
++			return ret;
++	}
++
++	return 0;
++}
++
++/* (H)SGMII SerDes calibration tables, taken verbatim from the GPL-2.0 Realtek
++ * vendor driver (rtl8367c_setAsicPortExtMode); each entry is a {data, addr}
++ * pair written through the SerDes indirect-access registers.
++ */
++static const u16 rtl8365mb_sds_sgmii[][2] = {
++	{ 0x04D7, 0x0480 }, { 0xF994, 0x0481 }, { 0x21A2, 0x0482 },
++	{ 0x6960, 0x0483 }, { 0x9728, 0x0484 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_sgmii_sb[][2] = {
++	{ 0x04D7, 0x0480 }, { 0xF994, 0x0481 }, { 0x31A2, 0x0482 },
++	{ 0x6960, 0x0483 }, { 0x9728, 0x0484 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_hsgmii_1[][2] = {
++	{ 0x82F1, 0x0500 }, { 0xF195, 0x0501 }, { 0x31A2, 0x0502 },
++	{ 0x796C, 0x0503 }, { 0x9728, 0x0504 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x0F80, 0x0001 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_hsgmii_8[][2] = {
++	{ 0x82F1, 0x0500 }, { 0xF995, 0x0501 }, { 0x31A2, 0x0502 },
++	{ 0x796C, 0x0503 }, { 0x9728, 0x0504 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x0F80, 0x0001 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_hsgmii_hb[][2] = {
++	{ 0x82F0, 0x0500 }, { 0xF195, 0x0501 }, { 0x31A2, 0x0502 },
++	{ 0x7960, 0x0503 }, { 0x9728, 0x0504 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x0F80, 0x0001 }, { 0x83F2, 0x002E },
++};
++
++static int rtl8365mb_sds_indacs_write(struct realtek_priv *priv, u16 data,
++				      u16 addr)
++{
++	int ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
++	if (ret)
++		return ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
++	if (ret)
++		return ret;
++
++	return regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
++			    RTL8365MB_SDS_INDACS_CMD_WRITE);
++}
++
++static int rtl8365mb_sds_indacs_read(struct realtek_priv *priv, u16 addr,
++				     u32 *data)
++{
++	int ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
++	if (ret)
++		return ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
++			   RTL8365MB_SDS_INDACS_CMD_READ);
++	if (ret)
++		return ret;
++
++	return regmap_read(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
++}
++
++/*
++ * Enable/disable SGMII in-band autonegotiation in the SerDes (SDS reg
++ * 0x0002 bit 9, bit 8 = commit) - vendor rtl8367c_setSgmiiNway(). The
++ * SerDes powers up with autoneg ENABLED; on a fixed-link trunk both MACs
++ * are forced, the handshake never completes and the SerDes silently
++ * drops every frame in both directions while the forced link still
++ * reports "up". The vendor driver calls
++ * rtk_port_sgmiiNway_set(..., DISABLED) right after forcing the
++ * ext-port link. The 8051 is paused around the read-modify-write,
++ * exactly as the vendor does (0x130C bit 5 = DW8051_EN).
++ */
++static int rtl8365mb_ext_sgmii_nway(struct realtek_priv *priv, bool enable)
++{
++	u32 running, val;
++	int ret, err;
++
++	ret = regmap_read(priv->map, RTL8365MB_MISC_CFG0_REG, &running);
++	if (ret)
++		return ret;
++	running &= RTL8365MB_MISC_CFG0_DW8051_EN_MASK;
++
++	if (running) {
++		ret = regmap_update_bits(priv->map, RTL8365MB_MISC_CFG0_REG,
++					 RTL8365MB_MISC_CFG0_DW8051_EN_MASK, 0);
++		if (ret)
++			return ret;
++	}
++
++	ret = rtl8365mb_sds_indacs_read(priv, 0x0002, &val);
++	if (ret)
++		goto out;
++
++	if (enable)
++		val |= 0x0200;
++	else
++		val &= ~0x0200;
++	val |= 0x0100;
++
++	ret = rtl8365mb_sds_indacs_write(priv, val, 0x0002);
++
++out:
++	if (running) {
++		err = regmap_update_bits(priv->map, RTL8365MB_MISC_CFG0_REG,
++					 RTL8365MB_MISC_CFG0_DW8051_EN_MASK,
++					 RTL8365MB_MISC_CFG0_DW8051_EN_MASK);
++		if (!ret)
++			ret = err;
++	}
++
++	return ret;
++}
++
++/*
++ * SDS link status - vendor rtl8367c_getSdsLinkStatus(): INDACS read of
++ * SDS reg 0x003D. Bit 8 = signal detect, bit 4 = link, bit 0 = sync;
++ * all three set = the SerDes RX is locked onto the far end's TX.
++ */
++#define RTL8365MB_SDS_STATUS_ADDR	0x003d
++#define RTL8365MB_SDS_STATUS_LOCKED	0x0111
++
++static int rtl8365mb_ext_sgmii_rx_locked(struct realtek_priv *priv,
++					 bool *locked)
++{
++	u32 val;
++	int ret;
++
++	ret = rtl8365mb_sds_indacs_read(priv, RTL8365MB_SDS_STATUS_ADDR, &val);
++	if (ret)
++		return ret;
++
++	*locked = (val & RTL8365MB_SDS_STATUS_LOCKED) ==
++		  RTL8365MB_SDS_STATUS_LOCKED;
++	return 0;
++}
++
++static int rtl8365mb_ext_config_sgmii(struct realtek_priv *priv, int port,
++				      phy_interface_t interface)
++{
++	struct rtl8365mb *mb;
++	const struct rtl8365mb_extint *extint =
++		rtl8365mb_get_port_extint(priv, port);
++	bool hsgmii = interface == PHY_INTERFACE_MODE_2500BASEX;
++	const u16 (*red)[2];
++	u32 chipver, option;
++	size_t red_cnt;
++	int ret;
++	size_t i;
++	u32 mode;
++
++	if (!extint)
++		return -ENODEV;
++
++	/* (H)SGMII is only available on extension interface 1 */
++	if (extint->id != 1)
++		return -EOPNOTSUPP;
++
++	/*
++	 * Clear the per-ext-port "bypass line rate" bit (reg 0x03F7). The
++	 * vendor rtl8367c driver does this first; leaving it set brings the
++	 * HSGMII trunk link up but stops it passing traffic.
++	 */
++	ret = regmap_update_bits(priv->map, 0x03F7, BIT(extint->id), 0);
++	if (ret)
++		return ret;
++
++	/* Read the chip "option" (magic-unlocked) to pick the SerDes table */
++	ret = regmap_write(priv->map, RTL8365MB_OPTION_MAGIC_REG,
++			   RTL8365MB_MAGIC_VALUE);
++	if (ret)
++		return ret;
++	ret = regmap_read(priv->map, RTL8365MB_OPTION_REG, &option);
++	if (ret)
++		return ret;
++	ret = regmap_write(priv->map, RTL8365MB_OPTION_MAGIC_REG, 0);
++	if (ret)
++		return ret;
++
++	if (!hsgmii) {
++		red = option ? rtl8365mb_sds_sgmii_sb : rtl8365mb_sds_sgmii;
++		red_cnt = ARRAY_SIZE(rtl8365mb_sds_sgmii);
++	} else {
++		/*
++		 * HSGMII: pick the SerDes table by chip VERSION, not by the
++		 * "option" bin. The AX55's RTL8367S reports option 1 but is
++		 * the same 0x00A0 part, so treat every option like option 0
++		 * (select by chipver) instead of bailing out - bailing left
++		 * the trunk SerDes unconfigured (no table, no 8051 firmware)
++		 * so the switch<->CPU datapath was dead in the RX direction.
++		 */
++		ret = regmap_write(priv->map, RTL8365MB_MAGIC_REG,
++				   RTL8365MB_MAGIC_VALUE);
++		if (ret)
++			return ret;
++		ret = regmap_read(priv->map, RTL8365MB_CHIP_VER_REG, &chipver);
++		if (ret)
++			return ret;
++		ret = regmap_write(priv->map, RTL8365MB_MAGIC_REG, 0);
++		if (ret)
++			return ret;
++
++		switch ((chipver & 0x00F0) >> 4) {
++		case 1:
++		case 5:
++		case 6:
++			red = rtl8365mb_sds_hsgmii_1;
++			break;
++		case 8:
++		case 9:
++			red = rtl8365mb_sds_hsgmii_8;
++			break;
++		default:
++			/* RTL8367S rev 0x00A0 (AX55) lands here */
++			red = rtl8365mb_sds_hsgmii_hb;
++			break;
++		}
++		red_cnt = ARRAY_SIZE(rtl8365mb_sds_hsgmii_hb);
++	}
++
++	for (i = 0; i < red_cnt; i++) {
++		ret = rtl8365mb_sds_indacs_write(priv, red[i][0], red[i][1]);
++		if (ret)
++			return ret;
++	}
++
++	/* Select SGMII or HSGMII on the MAC8 SerDes mux */
++	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
++				 RTL8365MB_SDS_MISC_MAC8_SGMII_MASK,
++				 hsgmii ? 0 : RTL8365MB_SDS_MISC_MAC8_SGMII_MASK);
++	if (ret)
++		return ret;
++	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
++				 RTL8365MB_SDS_MISC_MAC8_HSGMII_MASK,
++				 hsgmii ? RTL8365MB_SDS_MISC_MAC8_HSGMII_MASK : 0);
++	if (ret)
++		return ret;
++
++	/* Set the extension-interface mode */
++	mode = hsgmii ? RTL8365MB_EXT_PORT_MODE_HSGMII :
++			RTL8365MB_EXT_PORT_MODE_SGMII;
++	ret = regmap_update_bits(
++		priv->map, RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(extint->id),
++		RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_MASK(extint->id),
++		mode << RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_OFFSET(
++			       extint->id));
++	if (ret)
++		return ret;
++
++	/* "SerDes not reset" poke from the vendor driver */
++	ret = rtl8365mb_sds_indacs_write(priv, 0x7106, 0x0003);
++	if (ret)
++		return ret;
++
++	/*
++	 * Kill SGMII in-band autoneg in the SerDes: both trunk ends are
++	 * fixed-link/forced, AN would never complete and the SerDes drops
++	 * all traffic in both directions. Done while the 8051 is running
++	 * (pause/resume inside), exactly like the vendor flow.
++	 */
++	ret = rtl8365mb_ext_sgmii_nway(priv, false);
++	if (ret)
++		return ret;
++
++	mb = priv->chip_data;
++	mb->sds_nanny = true;
++	mb->sds_port = port;
++	mb->sds_interface = interface;
++
+ 	return 0;
+ }
+ 
++/*
++ * SerDes "babysitter", run from the CPU port's periodic MIB poll. The
++ * vendor's 8051 firmware (which this driver does not load) polls the SDS
++ * status in a loop and re-kicks the SerDes when it is out of sync; a
++ * cold-booted switch occasionally comes out of calibration with a
++ * receiver that never locks - or worse, one that reports lock on the SDS
++ * status register while delivering nothing but FCS-error garbage (every
++ * frame from the SoC counted as dot3StatsFCSErrors, zero good frames).
++ * Trust the data path, not just the status bit: the MIB poll that runs
++ * right before us already fetched the CPU port's cumulative FCS-error
++ * and good-frame counters, so compare them against the previous poll.
++ * On a bad poll, pulse the vendor SerDes reset (rtl8367c_sdsReset():
++ * SDS reg 0x0000 = 0x1401, then 0x1403); if the pulses don't help,
++ * escalate to a full SerDes re-configuration.
++ */
++static void rtl8365mb_ext_sgmii_nanny(struct realtek_priv *priv, int port)
++{
++	struct rtl8365mb *mb = priv->chip_data;
++	struct rtnl_link_stats64 *stats = &mb->ports[port].stats;
++	struct rtnl_link_stats64 conduit_stats;
++	const struct net_device *conduit;
++	u64 crc, pkts, seen, conduit_tx, tx_delta, seen_delta;
++	bool locked, garbage, lossy = false;
++	int ret;
++
++	spin_lock(&mb->ports[port].stats_lock);
++	crc = stats->rx_crc_errors;
++	pkts = stats->rx_packets;
++	seen = stats->rx_packets + stats->rx_errors + stats->rx_dropped;
++	spin_unlock(&mb->ports[port].stats_lock);
++
++	/* All new ingress frames on the trunk were FCS garbage */
++	garbage = crc > mb->sds_last_crc && pkts == mb->sds_last_rx;
++	mb->sds_last_crc = crc;
++	mb->sds_last_rx = pkts;
++
++	/*
++	 * The SerDes can also degrade to silently swallowing most frames:
++	 * no FCS errors, no fragments, the frames just never arrive (seen
++	 * on hardware as ~1 in 40 getting through while the SDS status
++	 * still reports lock). Passive port counters can't see that, so
++	 * compare against the other end of the trunk: everything the DSA
++	 * conduit transmits must show up on the CPU port as *something*
++	 * (a good frame or a counted error).
++	 */
++	conduit = dsa_to_port(&priv->ds, port)->conduit;
++	if (conduit) {
++		dev_get_stats((struct net_device *)conduit, &conduit_stats);
++		conduit_tx = conduit_stats.tx_packets;
++		tx_delta = conduit_tx - mb->sds_last_conduit_tx;
++		seen_delta = seen - mb->sds_last_seen;
++		if (mb->sds_last_conduit_tx && tx_delta >= 16 &&
++		    seen_delta * 4 < tx_delta)
++			lossy = true;
++		mb->sds_last_conduit_tx = conduit_tx;
++		mb->sds_last_seen = seen;
++	}
++
++	ret = rtl8365mb_ext_sgmii_rx_locked(priv, &locked);
++	if (ret)
++		return;
++
++	if (locked && !garbage && !lossy) {
++		if (mb->sds_pulses || mb->sds_bad_polls)
++			dev_info(priv->dev,
++				 "port %d SerDes healthy after %d reset pulse(s)\n",
++				 port, mb->sds_pulses);
++		mb->sds_pulses = 0;
++		mb->sds_bad_polls = 0;
++		return;
++	}
++
++	if ((garbage || lossy) && ++mb->sds_bad_polls >= 3) {
++		dev_warn(priv->dev,
++			 "port %d SerDes %s despite %s - re-running SerDes config\n",
++			 port, garbage ? "delivers FCS garbage" : "silently drops frames",
++			 locked ? "reporting lock" : "reset pulses");
++		ret = rtl8365mb_ext_config_sgmii(priv, port,
++						 mb->sds_interface);
++		if (ret)
++			dev_err(priv->dev,
++				"port %d SerDes re-config failed: %pe\n",
++				port, ERR_PTR(ret));
++		mb->sds_bad_polls = 0;
++		mb->sds_pulses = 0;
++		return;
++	}
++
++	ret = rtl8365mb_sds_indacs_write(priv, 0x1401, 0x0000);
++	if (!ret)
++		ret = rtl8365mb_sds_indacs_write(priv, 0x1403, 0x0000);
++	if (ret)
++		return;
++
++	if (++mb->sds_pulses == 10)
++		dev_warn(priv->dev,
++			 "port %d SerDes RX still not locked after %d reset pulses\n",
++			 port, mb->sds_pulses);
++}
++
+ static void rtl8365mb_phylink_get_caps(struct dsa_switch *ds, int port,
+ 				       struct phylink_config *config)
+ {
+@@ -1046,6 +1496,15 @@ static void rtl8365mb_phylink_get_caps(s
+ 
+ 	if (extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_RGMII)
+ 		phy_interface_set_rgmii(config->supported_interfaces);
++	if (extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_SGMII)
++		__set_bit(PHY_INTERFACE_MODE_SGMII,
++			  config->supported_interfaces);
++
++	if (extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_HSGMII) {
++		__set_bit(PHY_INTERFACE_MODE_2500BASEX,
++			  config->supported_interfaces);
++		config->mac_capabilities |= MAC_2500FD;
++	}
+ }
+ 
+ static void rtl8365mb_phylink_mac_config(struct phylink_config *config,
+@@ -1073,6 +1532,15 @@ static void rtl8365mb_phylink_mac_config
+ 		return;
+ 	}
+ 
++	if (state->interface == PHY_INTERFACE_MODE_SGMII ||
++	    state->interface == PHY_INTERFACE_MODE_2500BASEX) {
++		ret = rtl8365mb_ext_config_sgmii(priv, port, state->interface);
++		if (ret)
++			dev_err(priv->dev,
++				"failed to configure SGMII mode on port %d: %d\n",
++				port, ret);
++		return;
++	}
+ 	/* TODO: Implement MII and RMII modes, which the RTL8365MB-VC also
+ 	 * supports
+ 	 */
+@@ -1093,8 +1561,11 @@ static void rtl8365mb_phylink_mac_link_d
+ 	p = &mb->ports[port];
+ 	cancel_delayed_work_sync(&p->mib_work);
+ 
+-	if (phy_interface_mode_is_rgmii(interface)) {
+-		ret = rtl8365mb_ext_config_forcemode(priv, port, false, 0, 0,
++	if (phy_interface_mode_is_rgmii(interface) ||
++	    interface == PHY_INTERFACE_MODE_SGMII ||
++	    interface == PHY_INTERFACE_MODE_2500BASEX) {
++		ret = rtl8365mb_ext_config_forcemode(priv, port, interface,
++						     false, 0, 0,
+ 						     false, false);
+ 		if (ret)
+ 			dev_err(priv->dev,
+@@ -1123,8 +1594,11 @@ static void rtl8365mb_phylink_mac_link_u
+ 	p = &mb->ports[port];
+ 	schedule_delayed_work(&p->mib_work, 0);
+ 
+-	if (phy_interface_mode_is_rgmii(interface)) {
+-		ret = rtl8365mb_ext_config_forcemode(priv, port, true, speed,
++	if (phy_interface_mode_is_rgmii(interface) ||
++	    interface == PHY_INTERFACE_MODE_SGMII ||
++	    interface == PHY_INTERFACE_MODE_2500BASEX) {
++		ret = rtl8365mb_ext_config_forcemode(priv, port, interface,
++						     true, speed,
+ 						     duplex, tx_pause,
+ 						     rx_pause);
+ 		if (ret)
+@@ -1515,9 +1989,13 @@ static void rtl8365mb_stats_poll(struct
+ 						struct rtl8365mb_port,
+ 						mib_work);
+ 	struct realtek_priv *priv = p->priv;
++	struct rtl8365mb *mb = priv->chip_data;
+ 
+ 	rtl8365mb_stats_update(priv, p->index);
+ 
++	if (mb->sds_nanny && p->index == mb->sds_port)
++		rtl8365mb_ext_sgmii_nanny(priv, p->index);
++
+ 	schedule_delayed_work(&p->mib_work, RTL8365MB_STATS_INTERVAL_JIFFIES);
+ }
+ 
diff --git a/target/linux/qualcommax/patches-6.12/0920-clk-add-clk_hw_recalc_rate-to-trigger-HW-clk-rate-re.patch b/target/linux/qualcommax/patches-6.12/0920-clk-add-clk_hw_recalc_rate-to-trigger-HW-clk-rate-re.patch
new file mode 100644
index 0000000000..73444396f8
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0920-clk-add-clk_hw_recalc_rate-to-trigger-HW-clk-rate-re.patch
@@ -0,0 +1,99 @@
+From 49ae1f081626f1a8c91b283d06868a178a0a2e5a Mon Sep 17 00:00:00 2001
+From: Christian Marangi <ansuelsmth@gmail.com>
+Date: Tue, 17 Mar 2026 17:41:45 +0100
+Subject: [PATCH] clk: add clk_hw_recalc_rate() to trigger HW clk rate
+ recalculation
+
+There is currently a latent problem with HW clk that only expose a
+.recalc_rate OP and doesn't have a .set_rate() and also have the
+CLK_GET_RATE_NOCACHE flag set. In such case the rate in clk core is
+parsed only (and set) only at init and when the full clk_set_rate()
+is called. In every other case .recalc_rate() is never called.
+
+It's also possible that an HW clk of this type, initially report 0 as rate
+as the register are still not configured and the HW clk effectively doesn't
+return any rate.
+
+This gets especially problematic when a clock provider use such clk as a
+parent and require the rate for parent selection for the final rate
+calculation.
+
+In such case, since the HW clk rate is never updated after init, it's still
+0 and cause problems with any other HW clk that use .determine_rate() or
+.round_rate() and search for the closest rate using clk_hw_get_rate() on
+the parents.
+
+This doesn't happen if the full clk_get_rate() is used instead as it will
+check if CLK_GET_RATE_NOCACHE is set and recalculate the rate accordingly.
+
+Updating the clk_hw_get_rate() to align to what clk_get_rate() does is not
+possible as it should be lockless and might cause problems in any user of
+clk_hw_get_rate().
+
+A more safe approach is the introduction of a direct function that triggers
+the HW clk rate recalculation, clk_hw_recalc_rate().
+
+Any driver that implement an HW clk that entirely depends on some register
+to configure the rate (that are externally configured) and have only
+.recalc_rate() and set CLK_GET_RATE_NOCACHE (aka the case where the HW clk
+rate actually change and depends on the external register configuration)
+will have to call clk_hw_recalc_rate() on the HW clk after changing the
+register configuration to sync the CCF with the new rate for the HW clk.
+
+Example:
+
+ - All register zero -> HW clk rate = 0
+ - PCS configure USXGMII mode -> HW clk rate = 0
+ - PCS call clk_hw_recalc_rate() -> HW clk rate = 312MHz
+ - Port goes UP
+ - PCS/MAC scale the PHY port clock correctly by having
+   the correct reference clock as parent (instead of 0)
+
+Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
+---
+ drivers/clk/clk.c            | 23 +++++++++++++++++++++++
+ include/linux/clk-provider.h |  1 +
+ 2 files changed, 24 insertions(+)
+
+--- a/drivers/clk/clk.c
++++ b/drivers/clk/clk.c
+@@ -1990,6 +1990,29 @@ static unsigned long clk_core_get_rate_r
+ }
+ 
+ /**
++ * clk_hw_recalc_rate - trigger rate recalculation for clk_hw
++ * @hw: clk_hw associated with the clk to recalculate for
++ *
++ * Use clk_hw_recalc_rate() for the hw clk where the rate
++ * entirely depend on register configuration and doesn't have
++ * a .set_rate() OP. In such case, after modifying the register
++ * that would change the rate for the hw clk, call
++ * clk_hw_recalc_rate() to sync the CCF with the new clk rate.
++ */
++void clk_hw_recalc_rate(const struct clk_hw *hw)
++{
++	struct clk_core *core = hw->core;
++
++	if (!core || !(core->flags & CLK_GET_RATE_NOCACHE))
++		return;
++
++	clk_prepare_lock();
++	__clk_recalc_rates(core, false, 0);
++	clk_prepare_unlock();
++}
++EXPORT_SYMBOL_GPL(clk_hw_recalc_rate);
++
++/**
+  * clk_get_rate - return the rate of clk
+  * @clk: the clk whose rate is being returned
+  *
+--- a/include/linux/clk-provider.h
++++ b/include/linux/clk-provider.h
+@@ -1355,6 +1355,7 @@ int clk_hw_get_parent_index(struct clk_h
+ int clk_hw_set_parent(struct clk_hw *hw, struct clk_hw *new_parent);
+ unsigned int __clk_get_enable_count(struct clk *clk);
+ unsigned long clk_hw_get_rate(const struct clk_hw *hw);
++void clk_hw_recalc_rate(const struct clk_hw *hw);
+ unsigned long clk_hw_get_flags(const struct clk_hw *hw);
+ #define clk_hw_can_set_rate_parent(hw) \
+ 	(clk_hw_get_flags((hw)) & CLK_SET_RATE_PARENT)
diff --git a/target/linux/qualcommax/patches-6.12/0921-usb-dwc3-qcom-tcsr-phy-mux.patch b/target/linux/qualcommax/patches-6.12/0921-usb-dwc3-qcom-tcsr-phy-mux.patch
new file mode 100644
index 0000000000..75767c72ff
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0921-usb-dwc3-qcom-tcsr-phy-mux.patch
@@ -0,0 +1,73 @@
+From: OpenWrt
+Date: Mon, 6 Jul 2026 00:00:00 +0200
+Subject: [PATCH] usb: dwc3: qcom: support the TCSR USB phy mux (IPQ5018)
+
+On IPQ5018 the USB pads sit behind a PHY mux controlled from a TCSR
+register. The vendor (QSDK) dwc3-qcom driver selects the USB position by
+writing 1 there ("usb phy mux sel", qcom,phy-mux-regs); without it, on
+boards whose bootloader never touches USB (e.g. TP-Link Archer AX55 v1),
+the port stays muxed away and no device ever enumerates. Port the vendor
+property/behaviour as an optional DT hook.
+
+Signed-off-by: OpenWrt <noreply@openwrt.org>
+---
+--- a/drivers/usb/dwc3/dwc3-qcom.c
++++ b/drivers/usb/dwc3/dwc3-qcom.c
+@@ -22,6 +22,8 @@
+ #include <linux/iopoll.h>
+ #include <linux/usb/hcd.h>
+ #include <linux/usb.h>
++#include <linux/mfd/syscon.h>
++#include <linux/regmap.h>
+ #include "core.h"
+ 
+ /* USB QSCRATCH Hardware registers */
+@@ -730,6 +732,37 @@ static int dwc3_qcom_of_register_core(st
+ 	return ret;
+ }
+ 
++/*
++ * Some IPQ SoCs (e.g. IPQ5018) route the USB pads through a PHY mux
++ * controlled from a TCSR register; the bootloader does not necessarily
++ * select the USB position. Optional "qcom,phy-mux-regs" = <&tcsr offset>
++ * points at it; the vendor driver writes 1 ("usb phy mux sel") there.
++ */
++static int dwc3_qcom_setup_phy_mux(struct dwc3_qcom *qcom)
++{
++	struct of_phandle_args args;
++	struct regmap *map;
++	int ret;
++
++	ret = of_parse_phandle_with_fixed_args(qcom->dev->of_node,
++					       "qcom,phy-mux-regs", 1, 0,
++					       &args);
++	if (ret)
++		return 0;	/* optional */
++
++	map = syscon_node_to_regmap(args.np);
++	of_node_put(args.np);
++	if (IS_ERR(map))
++		return dev_err_probe(qcom->dev, PTR_ERR(map),
++				     "failed to map phy mux regs\n");
++
++	ret = regmap_write(map, args.args[0], 0x1);
++	if (ret)
++		dev_err(qcom->dev, "failed to select USB phy mux: %d\n", ret);
++
++	return ret;
++}
++
+ static int dwc3_qcom_probe(struct platform_device *pdev)
+ {
+ 	struct device_node	*np = pdev->dev.of_node;
+@@ -793,6 +826,10 @@ static int dwc3_qcom_probe(struct platfo
+ 	if (ignore_pipe_clk)
+ 		dwc3_qcom_select_utmi_clk(qcom);
+ 
++	ret = dwc3_qcom_setup_phy_mux(qcom);
++	if (ret)
++		goto clk_disable;
++
+ 	ret = dwc3_qcom_of_register_core(pdev);
+ 	if (ret) {
+ 		dev_err(dev, "failed to register DWC3 Core, err=%d\n", ret);
diff --git a/target/linux/qualcommax/patches-6.12/0922-phy-qcom-add-ipq5018-usb-ss-phy.patch b/target/linux/qualcommax/patches-6.12/0922-phy-qcom-add-ipq5018-usb-ss-phy.patch
new file mode 100644
index 0000000000..2180e11131
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0922-phy-qcom-add-ipq5018-usb-ss-phy.patch
@@ -0,0 +1,200 @@
+From: OpenWrt
+Date: Tue, 7 Jul 2026 14:00:00 +0200
+Subject: [PATCH] phy: qcom: add IPQ5018 USB SuperSpeed uni PHY driver
+
+Port of the QSDK phy-qca-uniphy.c driver (qca,ipq5018-uni-ssphy):
+enable the clocks, pulse the PHY POR reset (GCC_USB0_PHY_BCR), wait
+for the fuse autoload, then program five SSCG (spread spectrum)
+registers with fixed values.
+
+Crucially, the phy register file at 0x5d000 responds ONLY when the
+usb0 aux and lfps clocks run as well - with either gated, even a read
+hangs the AHB bus (CPU stall, watchdog cannot fire since the other
+core keeps petting it). The vendor driver only takes pipe+cfg_ahb
+because the vendor dwc3 node's clock list carries aux/lfps and the
+controller enables them before phy init; this driver takes all four
+so it cannot be broken by controller clock ordering.
+
+Without this PHY initialized, USB3 devices see phantom terminations
+on the dead SS pairs, keep retrying SS link training and never fall
+back to USB2 - the port appears completely dead for them.
+
+Signed-off-by: OpenWrt <noreply@openwrt.org>
+---
+--- a/drivers/phy/qualcomm/Kconfig
++++ b/drivers/phy/qualcomm/Kconfig
+@@ -154,6 +154,15 @@ config PHY_QCOM_M31_USB
+ 	  management. This driver is required even for peripheral only or
+ 	  host only mode configurations.
+ 
++config PHY_QCOM_IPQ5018_USB_SS
++	tristate "Qualcomm IPQ5018 USB SS PHY driver support"
++	depends on USB && (ARCH_QCOM || COMPILE_TEST)
++	select GENERIC_PHY
++	help
++	  Enable this to support the SuperSpeed "uni" PHY transceiver
++	  that is paired with the DWC3 USB core on the Qualcomm IPQ5018
++	  SoC.
++
+ config PHY_QCOM_UNIPHY_PCIE_28LP
+ 	bool "PCIE UNIPHY 28LP PHY driver"
+ 	depends on ARCH_QCOM
+--- a/drivers/phy/qualcomm/Makefile
++++ b/drivers/phy/qualcomm/Makefile
+@@ -4,6 +4,7 @@ obj-$(CONFIG_PHY_QCOM_APQ8064_SATA)	+= p
+ obj-$(CONFIG_PHY_QCOM_EDP)		+= phy-qcom-edp.o
+ obj-$(CONFIG_PHY_QCOM_IPQ4019_USB)	+= phy-qcom-ipq4019-usb.o
+ obj-$(CONFIG_PHY_QCOM_IPQ806X_SATA)	+= phy-qcom-ipq806x-sata.o
++obj-$(CONFIG_PHY_QCOM_IPQ5018_USB_SS)	+= phy-qcom-ipq5018-usb-ss.o
+ obj-$(CONFIG_PHY_QCOM_M31_USB)		+= phy-qcom-m31.o
+ obj-$(CONFIG_PHY_QCOM_PCIE2)		+= phy-qcom-pcie2.o
+ 
+--- /dev/null
++++ b/drivers/phy/qualcomm/phy-qcom-ipq5018-usb-ss.c
+@@ -0,0 +1,146 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Qualcomm IPQ5018 USB SuperSpeed "uni" PHY driver
++ *
++ * Minimal port of the QSDK phy-qca-uniphy.c (qca,ipq5018-uni-ssphy
++ * branch): pulse the PHY POR reset, enable the clocks, wait for the
++ * fuse autoload, then program the SSCG (spread spectrum) registers.
++ */
++
++#include <linux/clk.h>
++#include <linux/delay.h>
++#include <linux/io.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/phy/phy.h>
++#include <linux/platform_device.h>
++#include <linux/reset.h>
++
++#define SSCG_CTRL_REG_1		0x9c
++#define SSCG_CTRL_REG_2		0xa0
++#define SSCG_CTRL_REG_3		0xa4
++#define SSCG_CTRL_REG_4		0xa8
++#define SSCG_CTRL_REG_5		0xac
++
++/* time (us) the PHY takes to autoload its fuse calibration after POR */
++#define PHY_AUTOLOAD_DELAY_US	35
++
++#define NUM_CLKS	4
++
++struct ipq5018_usb_ss_phy {
++	void __iomem *base;
++	struct clk_bulk_data clks[NUM_CLKS];
++	struct reset_control *por_rst;
++};
++
++static void ssphy_write(struct ipq5018_usb_ss_phy *phy, u32 off, u32 val)
++{
++	writel(val, phy->base + off);
++	udelay(100);
++}
++
++static int ipq5018_usb_ss_phy_init(struct phy *_phy)
++{
++	struct ipq5018_usb_ss_phy *phy = phy_get_drvdata(_phy);
++	int ret;
++
++	/*
++	 * All four clocks must run before the register file responds -
++	 * with aux/lfps gated, even a read of the SSCG registers hangs
++	 * the bus (found the hard way). The vendor driver gets away with
++	 * enabling only pipe+cfg_ahb because the vendor dwc3 node clock
++	 * list (which the controller enables before the phy init) also
++	 * carries aux and lfps.
++	 */
++	ret = clk_bulk_prepare_enable(NUM_CLKS, phy->clks);
++	if (ret)
++		return ret;
++
++	reset_control_assert(phy->por_rst);
++	usleep_range(100, 200);
++	reset_control_deassert(phy->por_rst);
++
++	udelay(PHY_AUTOLOAD_DELAY_US);
++
++	ssphy_write(phy, SSCG_CTRL_REG_4, 0x1cb9);
++	ssphy_write(phy, SSCG_CTRL_REG_5, 0x023a);
++	ssphy_write(phy, SSCG_CTRL_REG_3, 0xd360);
++	ssphy_write(phy, SSCG_CTRL_REG_1, 0x1);
++	ssphy_write(phy, SSCG_CTRL_REG_2, 0xeb);
++
++	return 0;
++}
++
++static int ipq5018_usb_ss_phy_exit(struct phy *_phy)
++{
++	struct ipq5018_usb_ss_phy *phy = phy_get_drvdata(_phy);
++
++	clk_bulk_disable_unprepare(NUM_CLKS, phy->clks);
++	reset_control_assert(phy->por_rst);
++
++	return 0;
++}
++
++static const struct phy_ops ipq5018_usb_ss_phy_ops = {
++	.init = ipq5018_usb_ss_phy_init,
++	.exit = ipq5018_usb_ss_phy_exit,
++	.owner = THIS_MODULE,
++};
++
++static int ipq5018_usb_ss_phy_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct ipq5018_usb_ss_phy *phy;
++	struct phy_provider *provider;
++	struct phy *generic_phy;
++	int ret;
++
++	phy = devm_kzalloc(dev, sizeof(*phy), GFP_KERNEL);
++	if (!phy)
++		return -ENOMEM;
++
++	phy->base = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(phy->base))
++		return PTR_ERR(phy->base);
++
++	phy->por_rst = devm_reset_control_get_exclusive(dev, NULL);
++	if (IS_ERR(phy->por_rst))
++		return dev_err_probe(dev, PTR_ERR(phy->por_rst),
++				     "failed to get POR reset\n");
++
++	phy->clks[0].id = "pipe";
++	phy->clks[1].id = "cfg_ahb";
++	phy->clks[2].id = "aux";
++	phy->clks[3].id = "lfps";
++	ret = devm_clk_bulk_get(dev, NUM_CLKS, phy->clks);
++	if (ret)
++		return dev_err_probe(dev, ret, "failed to get clocks\n");
++
++	generic_phy = devm_phy_create(dev, NULL, &ipq5018_usb_ss_phy_ops);
++	if (IS_ERR(generic_phy))
++		return PTR_ERR(generic_phy);
++
++	phy_set_drvdata(generic_phy, phy);
++
++	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
++
++	return PTR_ERR_OR_ZERO(provider);
++}
++
++static const struct of_device_id ipq5018_usb_ss_phy_of_match[] = {
++	{ .compatible = "qcom,ipq5018-usb-ssphy" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, ipq5018_usb_ss_phy_of_match);
++
++static struct platform_driver ipq5018_usb_ss_phy_driver = {
++	.probe = ipq5018_usb_ss_phy_probe,
++	.driver = {
++		.name = "ipq5018-usb-ssphy",
++		.of_match_table = ipq5018_usb_ss_phy_of_match,
++	},
++};
++module_platform_driver(ipq5018_usb_ss_phy_driver);
++
++MODULE_DESCRIPTION("Qualcomm IPQ5018 USB SS uni PHY driver");
++MODULE_LICENSE("GPL");
diff --git a/target/linux/qualcommax/patches-6.12/0923-usb-dwc3-qcom-select-phy-mux-before-reset.patch b/target/linux/qualcommax/patches-6.12/0923-usb-dwc3-qcom-select-phy-mux-before-reset.patch
new file mode 100644
index 0000000000..6aeb6ad14b
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0923-usb-dwc3-qcom-select-phy-mux-before-reset.patch
@@ -0,0 +1,52 @@
+From: Stanislaw Pal <kuncy7@gmail.com>
+Subject: [PATCH] usb: dwc3: qcom: select the phy mux before the reset
+
+On IPQ5018 the USB pads are shared with PCIe through a mux in TCSR.
+The selection was made near the end of probe, after the controller had
+already been through its reset and after the clocks were up.
+
+The vendor driver (QSDK dwc3-qcom.c, qcom,multiplexed-phy) writes the
+selection as the very first thing in probe, ahead of the usb30 master
+reset and the clock setup. Match that: the SuperSpeed pads are muxed
+away for the whole reset otherwise, and the link never leaves
+Rx.Detect. USB2 does not go through this mux, which is why high speed
+worked throughout.
+
+Measured on a TP-Link Archer AX55 v1: with this change a USB3 stick
+enumerates at SuperSpeed and hdparm reports 112-116 MB/s, against
+~100 MB/s under the vendor firmware.
+
+Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
+---
+--- a/drivers/usb/dwc3/dwc3-qcom.c
++++ b/drivers/usb/dwc3/dwc3-qcom.c
+@@ -779,6 +779,18 @@
+ 	platform_set_drvdata(pdev, qcom);
+ 	qcom->dev = &pdev->dev;
+ 
++	/*
++	 * Select the USB position of the phy mux before anything comes out
++	 * of reset. The vendor driver does this as the first thing in probe,
++	 * ahead of the controller reset and the clocks; selecting it later
++	 * leaves the SuperSpeed pads muxed away while the controller resets,
++	 * and the SS link then never leaves Rx.Detect (USB2 is unaffected,
++	 * it does not go through this mux).
++	 */
++	ret = dwc3_qcom_setup_phy_mux(qcom);
++	if (ret)
++		return ret;
++
+ 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
+ 	if (IS_ERR(qcom->resets)) {
+ 		return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
+@@ -826,10 +838,6 @@
+ 	if (ignore_pipe_clk)
+ 		dwc3_qcom_select_utmi_clk(qcom);
+ 
+-	ret = dwc3_qcom_setup_phy_mux(qcom);
+-	if (ret)
+-		goto clk_disable;
+-
+ 	ret = dwc3_qcom_of_register_core(pdev);
+ 	if (ret) {
+ 		dev_err(dev, "failed to register DWC3 Core, err=%d\n", ret);
