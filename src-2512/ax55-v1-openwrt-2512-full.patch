diff --git a/target/linux/qualcommax/patches-6.12/0918-net-dsa-realtek-rtl8365mb-add-sgmii-hsgmii-support.patch b/target/linux/qualcommax/patches-6.12/0918-net-dsa-realtek-rtl8365mb-add-sgmii-hsgmii-support.patch
new file mode 100644
index 0000000000..dc921510bc
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0918-net-dsa-realtek-rtl8365mb-add-sgmii-hsgmii-support.patch
@@ -0,0 +1,604 @@
+From: OpenWrt
+Date: Tue, 7 Jul 2026 20:00:00 +0200
+Subject: [PATCH] net: dsa: realtek: rtl8365mb: add SGMII and HSGMII support
+
+The mainline rtl8365mb driver only configures RGMII on the extension
+interface, so switches such as the RTL8367S that are connected to the SoC
+over a (2.5G) SGMII/HSGMII link cannot be brought up (phylink_mac_config
+is a no-op for non-RGMII and SGMII/2500BASEX are not advertised).
+
+Add SGMII and HSGMII (advertised as 2500BASE-X) support for extension
+interface 1. The SerDes calibration tables are taken from the GPL-2.0
+Realtek vendor driver that already lives in OpenWrt's mediatek target
+(rtl8367c_setAsicPortExtMode). Unlike the vendor driver, no 8051 SerDes
+firmware is needed: the vendor firmware acts as a runtime babysitter for
+the SerDes, and bring-up works without it as long as the SerDes in-band
+SGMII autoneg is disabled and the link parameters are forced (verified
+on hardware: full 2.5G trunk operation, NAT throughput included).
+
+The SDS_MISC force bits (link/speed/duplex/pause) and the SGMII in-band
+autoneg disable are both mandatory - each alone leaves a link-up trunk
+that passes no traffic (verified live on AX55 hardware).
+
+This is a re-derivation of Hauke Mehrtens' 2022 netdev series, minus the
+firmware blob whose licensing blocked it back then.
+
+Needed for the TP-Link Archer AX55 v1 (IPQ5018 + RTL8367S).
+
+Rebased onto the v7.2 backports (942-xx) that split rtl8365mb.c into
+rtl8365mb.c and rtl8365mb_l2.c.
+
+Signed-off-by: OpenWrt <noreply@openwrt.org>
+---
+
+Cold-boot reliability: poll the SDS status from the CPU port MIB work: verify the
+SerDes RX is locked (SDS status 0x3D) and pulse the vendor's
+SerDes reset from the CPU port MIB poll until it does - this replaces the 8051 firmware's
+babysitter loop for the one case where it matters.
+
+--- a/drivers/net/dsa/realtek/rtl8365mb.c
++++ b/drivers/net/dsa/realtek/rtl8365mb.c
+@@ -207,6 +207,38 @@
+ #define RTL8365MB_EXT_PORT_MODE_1000X_100FX	11
+ #define RTL8365MB_EXT_PORT_MODE_1000X		12
+ #define RTL8365MB_EXT_PORT_MODE_100FX		13
++/* Registers used to bring up the (H)SGMII extension interface. The
++ * RTL8365MB_MAGIC_REG/RTL8365MB_MAGIC_VALUE, RTL8365MB_CHIP_VER_REG and
++ * RTL8365MB_CHIP_RESET_REG defines already exist above and are reused here.
++ */
++#define RTL8365MB_OPTION_MAGIC_REG		0x13C0
++#define RTL8365MB_OPTION_REG			0x13C1
++
++#define RTL8365MB_MISC_CFG0_REG			0x130C
++#define   RTL8365MB_MISC_CFG0_DW8051_EN_MASK	0x0020
++
++#define   RTL8365MB_CHIP_RESET_DW8051_MASK	0x0010
++
++#define RTL8365MB_DW8051_RDY_REG		0x1336
++#define   RTL8365MB_DW8051_RDY_ACS_IROM_MASK	0x0002
++#define   RTL8365MB_DW8051_RDY_IROM_MSB_MASK	0x0004
++#define RTL8365MB_DW8051_IRAM_BASE		0xE000
++
++#define RTL8365MB_SDS_MISC_REG			0x1D11
++#define   RTL8365MB_SDS_MISC_MAC8_SGMII_MASK	0x0040
++#define   RTL8365MB_SDS_MISC_MAC8_HSGMII_MASK	0x0800
++#define   RTL8365MB_SDS_MISC_SGMII_RXFC_MASK	0x4000
++#define   RTL8365MB_SDS_MISC_SGMII_TXFC_MASK	0x2000
++#define   RTL8365MB_SDS_MISC_SGMII_FDUP_MASK	0x0400
++#define   RTL8365MB_SDS_MISC_SGMII_LINK_MASK	0x0200
++#define   RTL8365MB_SDS_MISC_SGMII_SPD_MASK	0x0180
++
++#define RTL8365MB_SDS_INDACS_CMD_REG		0x6600
++#define   RTL8365MB_SDS_INDACS_CMD_WRITE	0x00C0
++#define   RTL8365MB_SDS_INDACS_CMD_READ		0x0080
++#define RTL8365MB_SDS_INDACS_ADR_REG		0x6601
++#define RTL8365MB_SDS_INDACS_DATA_REG		0x6602
++
+ 
+ /* External interface mode configuration registers 0~1 */
+ #define RTL8365MB_DIGITAL_INTERFACE_SELECT_REG0		0x1305 /* EXT0,EXT1 */
+@@ -645,6 +677,16 @@ struct rtl8365mb {
+ 	struct rtl8365mb_cpu cpu;
+ 	struct mutex mib_lock;
+ 	struct rtl8365mb_port ports[RTL8365MB_MAX_NUM_PORTS];
++	/* SerDes RX "babysitter" state (see rtl8365mb_ext_sgmii_nanny) */
++	bool sds_nanny;
++	int sds_port;
++	int sds_pulses;
++	int sds_bad_polls;
++	u64 sds_last_crc;
++	u64 sds_last_rx;
++	u64 sds_last_conduit_tx;
++	u64 sds_last_seen;
++	phy_interface_t sds_interface;
+ };
+ 
+ static int rtl8365mb_phy_poll_busy(struct realtek_priv *priv)
+@@ -948,6 +990,7 @@ static int rtl8365mb_ext_config_rgmii(st
+ }
+ 
+ static int rtl8365mb_ext_config_forcemode(struct realtek_priv *priv, int port,
++					  phy_interface_t interface,
+ 					  bool link, int speed, int duplex,
+ 					  bool tx_pause, bool rx_pause)
+ {
+@@ -970,7 +1013,7 @@ static int rtl8365mb_ext_config_forcemod
+ 		r_rx_pause = rx_pause ? 1 : 0;
+ 		r_tx_pause = tx_pause ? 1 : 0;
+ 
+-		if (speed == SPEED_1000) {
++		if (speed == SPEED_2500 || speed == SPEED_1000) {
+ 			r_speed = RTL8365MB_PORT_SPEED_1000M;
+ 		} else if (speed == SPEED_100) {
+ 			r_speed = RTL8365MB_PORT_SPEED_100M;
+@@ -1015,9 +1058,416 @@ static int rtl8365mb_ext_config_forcemod
+ 	if (ret)
+ 		return ret;
+ 
++	/*
++	 * For the SGMII/HSGMII extension interface the digital-interface
++	 * force register above is not enough: the SerDes MAC link (speed/
++	 * duplex/link/pause) must also be forced in the SDS_MISC register,
++	 * exactly as the vendor rtl8367c setAsicPortForceLinkExt() does for
++	 * ext id 1. Without this the link is reported up but the trunk
++	 * passes no traffic in either direction (verified live on the AX55:
++	 * setting the LINK bit by hand instantly brought DHCP up).
++	 */
++	if (interface == PHY_INTERFACE_MODE_SGMII ||
++	    interface == PHY_INTERFACE_MODE_2500BASEX) {
++		u32 sds_mask = RTL8365MB_SDS_MISC_SGMII_RXFC_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_TXFC_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_FDUP_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_LINK_MASK |
++			       RTL8365MB_SDS_MISC_SGMII_SPD_MASK;
++		u32 sds_val =
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_RXFC_MASK, r_rx_pause) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_TXFC_MASK, r_tx_pause) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_FDUP_MASK, r_duplex) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_LINK_MASK, r_link) |
++			FIELD_PREP(RTL8365MB_SDS_MISC_SGMII_SPD_MASK, r_speed);
++
++		ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
++					 sds_mask, sds_val);
++		if (ret)
++			return ret;
++	}
++
++	return 0;
++}
++
++/* (H)SGMII SerDes calibration tables, taken verbatim from the GPL-2.0 Realtek
++ * vendor driver (rtl8367c_setAsicPortExtMode); each entry is a {data, addr}
++ * pair written through the SerDes indirect-access registers.
++ */
++static const u16 rtl8365mb_sds_sgmii[][2] = {
++	{ 0x04D7, 0x0480 }, { 0xF994, 0x0481 }, { 0x21A2, 0x0482 },
++	{ 0x6960, 0x0483 }, { 0x9728, 0x0484 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_sgmii_sb[][2] = {
++	{ 0x04D7, 0x0480 }, { 0xF994, 0x0481 }, { 0x31A2, 0x0482 },
++	{ 0x6960, 0x0483 }, { 0x9728, 0x0484 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_hsgmii_1[][2] = {
++	{ 0x82F1, 0x0500 }, { 0xF195, 0x0501 }, { 0x31A2, 0x0502 },
++	{ 0x796C, 0x0503 }, { 0x9728, 0x0504 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x0F80, 0x0001 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_hsgmii_8[][2] = {
++	{ 0x82F1, 0x0500 }, { 0xF995, 0x0501 }, { 0x31A2, 0x0502 },
++	{ 0x796C, 0x0503 }, { 0x9728, 0x0504 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x0F80, 0x0001 }, { 0x83F2, 0x002E },
++};
++
++static const u16 rtl8365mb_sds_hsgmii_hb[][2] = {
++	{ 0x82F0, 0x0500 }, { 0xF195, 0x0501 }, { 0x31A2, 0x0502 },
++	{ 0x7960, 0x0503 }, { 0x9728, 0x0504 }, { 0x9D85, 0x0423 },
++	{ 0xD810, 0x0424 }, { 0x0F80, 0x0001 }, { 0x83F2, 0x002E },
++};
++
++static int rtl8365mb_sds_indacs_write(struct realtek_priv *priv, u16 data,
++				      u16 addr)
++{
++	int ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
++	if (ret)
++		return ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
++	if (ret)
++		return ret;
++
++	return regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
++			    RTL8365MB_SDS_INDACS_CMD_WRITE);
++}
++
++static int rtl8365mb_sds_indacs_read(struct realtek_priv *priv, u16 addr,
++				     u32 *data)
++{
++	int ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
++	if (ret)
++		return ret;
++
++	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
++			   RTL8365MB_SDS_INDACS_CMD_READ);
++	if (ret)
++		return ret;
++
++	return regmap_read(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
++}
++
++/*
++ * Enable/disable SGMII in-band autonegotiation in the SerDes (SDS reg
++ * 0x0002 bit 9, bit 8 = commit) - vendor rtl8367c_setSgmiiNway(). The
++ * SerDes powers up with autoneg ENABLED; on a fixed-link trunk both MACs
++ * are forced, the handshake never completes and the SerDes silently
++ * drops every frame in both directions while the forced link still
++ * reports "up". The vendor driver calls
++ * rtk_port_sgmiiNway_set(..., DISABLED) right after forcing the
++ * ext-port link. The 8051 is paused around the read-modify-write,
++ * exactly as the vendor does (0x130C bit 5 = DW8051_EN).
++ */
++static int rtl8365mb_ext_sgmii_nway(struct realtek_priv *priv, bool enable)
++{
++	u32 running, val;
++	int ret, err;
++
++	ret = regmap_read(priv->map, RTL8365MB_MISC_CFG0_REG, &running);
++	if (ret)
++		return ret;
++	running &= RTL8365MB_MISC_CFG0_DW8051_EN_MASK;
++
++	if (running) {
++		ret = regmap_update_bits(priv->map, RTL8365MB_MISC_CFG0_REG,
++					 RTL8365MB_MISC_CFG0_DW8051_EN_MASK, 0);
++		if (ret)
++			return ret;
++	}
++
++	ret = rtl8365mb_sds_indacs_read(priv, 0x0002, &val);
++	if (ret)
++		goto out;
++
++	if (enable)
++		val |= 0x0200;
++	else
++		val &= ~0x0200;
++	val |= 0x0100;
++
++	ret = rtl8365mb_sds_indacs_write(priv, val, 0x0002);
++
++out:
++	if (running) {
++		err = regmap_update_bits(priv->map, RTL8365MB_MISC_CFG0_REG,
++					 RTL8365MB_MISC_CFG0_DW8051_EN_MASK,
++					 RTL8365MB_MISC_CFG0_DW8051_EN_MASK);
++		if (!ret)
++			ret = err;
++	}
++
++	return ret;
++}
++
++/*
++ * SDS link status - vendor rtl8367c_getSdsLinkStatus(): INDACS read of
++ * SDS reg 0x003D. Bit 8 = signal detect, bit 4 = link, bit 0 = sync;
++ * all three set = the SerDes RX is locked onto the far end's TX.
++ */
++#define RTL8365MB_SDS_STATUS_ADDR	0x003d
++#define RTL8365MB_SDS_STATUS_LOCKED	0x0111
++
++static int rtl8365mb_ext_sgmii_rx_locked(struct realtek_priv *priv,
++					 bool *locked)
++{
++	u32 val;
++	int ret;
++
++	ret = rtl8365mb_sds_indacs_read(priv, RTL8365MB_SDS_STATUS_ADDR, &val);
++	if (ret)
++		return ret;
++
++	*locked = (val & RTL8365MB_SDS_STATUS_LOCKED) ==
++		  RTL8365MB_SDS_STATUS_LOCKED;
++	return 0;
++}
++
++static int rtl8365mb_ext_config_sgmii(struct realtek_priv *priv, int port,
++				      phy_interface_t interface)
++{
++	struct rtl8365mb *mb;
++	const struct rtl8365mb_extint *extint =
++		rtl8365mb_get_port_extint(priv, port);
++	bool hsgmii = interface == PHY_INTERFACE_MODE_2500BASEX;
++	const u16 (*red)[2];
++	u32 chipver, option;
++	size_t red_cnt;
++	int ret;
++	size_t i;
++	u32 mode;
++
++	if (!extint)
++		return -ENODEV;
++
++	/* (H)SGMII is only available on extension interface 1 */
++	if (extint->id != 1)
++		return -EOPNOTSUPP;
++
++	/*
++	 * Clear the per-ext-port "bypass line rate" bit (reg 0x03F7). The
++	 * vendor rtl8367c driver does this first; leaving it set brings the
++	 * HSGMII trunk link up but stops it passing traffic.
++	 */
++	ret = regmap_update_bits(priv->map, 0x03F7, BIT(extint->id), 0);
++	if (ret)
++		return ret;
++
++	/* Read the chip "option" (magic-unlocked) to pick the SerDes table */
++	ret = regmap_write(priv->map, RTL8365MB_OPTION_MAGIC_REG,
++			   RTL8365MB_MAGIC_VALUE);
++	if (ret)
++		return ret;
++	ret = regmap_read(priv->map, RTL8365MB_OPTION_REG, &option);
++	if (ret)
++		return ret;
++	ret = regmap_write(priv->map, RTL8365MB_OPTION_MAGIC_REG, 0);
++	if (ret)
++		return ret;
++
++	if (!hsgmii) {
++		red = option ? rtl8365mb_sds_sgmii_sb : rtl8365mb_sds_sgmii;
++		red_cnt = ARRAY_SIZE(rtl8365mb_sds_sgmii);
++	} else {
++		/*
++		 * HSGMII: pick the SerDes table by chip VERSION, not by the
++		 * "option" bin. The AX55's RTL8367S reports option 1 but is
++		 * the same 0x00A0 part, so treat every option like option 0
++		 * (select by chipver) instead of bailing out - bailing left
++		 * the trunk SerDes unconfigured (no table, no 8051 firmware)
++		 * so the switch<->CPU datapath was dead in the RX direction.
++		 */
++		ret = regmap_write(priv->map, RTL8365MB_MAGIC_REG,
++				   RTL8365MB_MAGIC_VALUE);
++		if (ret)
++			return ret;
++		ret = regmap_read(priv->map, RTL8365MB_CHIP_VER_REG, &chipver);
++		if (ret)
++			return ret;
++		ret = regmap_write(priv->map, RTL8365MB_MAGIC_REG, 0);
++		if (ret)
++			return ret;
++
++		switch ((chipver & 0x00F0) >> 4) {
++		case 1:
++		case 5:
++		case 6:
++			red = rtl8365mb_sds_hsgmii_1;
++			break;
++		case 8:
++		case 9:
++			red = rtl8365mb_sds_hsgmii_8;
++			break;
++		default:
++			/* RTL8367S rev 0x00A0 (AX55) lands here */
++			red = rtl8365mb_sds_hsgmii_hb;
++			break;
++		}
++		red_cnt = ARRAY_SIZE(rtl8365mb_sds_hsgmii_hb);
++	}
++
++	for (i = 0; i < red_cnt; i++) {
++		ret = rtl8365mb_sds_indacs_write(priv, red[i][0], red[i][1]);
++		if (ret)
++			return ret;
++	}
++
++	/* Select SGMII or HSGMII on the MAC8 SerDes mux */
++	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
++				 RTL8365MB_SDS_MISC_MAC8_SGMII_MASK,
++				 hsgmii ? 0 : RTL8365MB_SDS_MISC_MAC8_SGMII_MASK);
++	if (ret)
++		return ret;
++	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
++				 RTL8365MB_SDS_MISC_MAC8_HSGMII_MASK,
++				 hsgmii ? RTL8365MB_SDS_MISC_MAC8_HSGMII_MASK : 0);
++	if (ret)
++		return ret;
++
++	/* Set the extension-interface mode */
++	mode = hsgmii ? RTL8365MB_EXT_PORT_MODE_HSGMII :
++			RTL8365MB_EXT_PORT_MODE_SGMII;
++	ret = regmap_update_bits(
++		priv->map, RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(extint->id),
++		RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_MASK(extint->id),
++		mode << RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_OFFSET(
++			       extint->id));
++	if (ret)
++		return ret;
++
++	/* "SerDes not reset" poke from the vendor driver */
++	ret = rtl8365mb_sds_indacs_write(priv, 0x7106, 0x0003);
++	if (ret)
++		return ret;
++
++	/*
++	 * Kill SGMII in-band autoneg in the SerDes: both trunk ends are
++	 * fixed-link/forced, AN would never complete and the SerDes drops
++	 * all traffic in both directions. Done while the 8051 is running
++	 * (pause/resume inside), exactly like the vendor flow.
++	 */
++	ret = rtl8365mb_ext_sgmii_nway(priv, false);
++	if (ret)
++		return ret;
++
++	mb = priv->chip_data;
++	mb->sds_nanny = true;
++	mb->sds_port = port;
++	mb->sds_interface = interface;
++
+ 	return 0;
+ }
