+ipq50xx_setup_macs()
+{
+	local board="$1"
+	local label_mac=""
+
+	case $board in
+	tplink,archer-ax55-v1)
+		# factory MAC is 6 raw bytes in tp_data/default-mac, mounted
+		# read-only during preinit (see lib/preinit/09_mount_tp_data)
+		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
+		[ -n "$label_mac" ] || return
+		ucidef_set_interface_macaddr "lan" "$label_mac"
+		ucidef_set_interface_macaddr "wan" "$(macaddr_add "$label_mac" 1)"
+		ucidef_set_label_macaddr "$label_mac"
+		# gmac1 has no nvmem MAC source, so stmmac would randomise the
+		# DSA conduit's address on every boot - pin it to the label MAC
+		ucidef_set_network_device_mac "eth0" "$label_mac"
+		;;
+	esac
+}
+
 board_config_update
 board=$(board_name)
 ipq50xx_setup_interfaces $board
+ipq50xx_setup_macs $board
