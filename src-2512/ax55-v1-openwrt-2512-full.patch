diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-tplink-archer-ax55-v1.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-tplink-archer-ax55-v1.dts
new file mode 100644
index 0000000000..6e42dfbbe4
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-tplink-archer-ax55-v1.dts
@@ -0,0 +1,604 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq5018.dtsi"
+#include "ipq5018-dwmac.dtsi"
+#include "ipq5018-qcn6122.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "TP-Link Archer AX55 v1";
+	compatible = "tplink,archer-ax55-v1", "qcom,ipq5018";
+
+	aliases {
+		serial0 = &blsp1_uart1;
+		led-boot = &led_power;
+		led-failsafe = &led_power;
+		led-running = &led_power;
+		led-upgrade = &led_power;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/*
+		 * Stage 3a brings the board up via an initramfs image booted
+		 * from RAM (TFTP); root= is unused for now and is revisited
+		 * with the on-flash layout in stage 3e.
+		 */
+		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		button-reset {
+			label = "reset";
+			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+
+		/* the case labels this "WPS/Wi-Fi"; stock treats it as a
+		 * wifi toggle (KEY_WLAN) - use rfkill, the OpenWrt idiom */
+		button-wifi {
+			label = "wifi";
+			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RFKILL>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&led_pins>;
+		pinctrl-names = "default";
+
+		/*
+		 * LED GPIOs confirmed against the stock device tree. GPIO39 is
+		 * the 5 GHz WLAN LED (the OEM "reset_gpio 39" in the switch
+		 * node is bogus - the real RTL8367S reset is GPIO33).
+		 */
+		led_power: led-power {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-lan {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_LAN;
+			gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-wan-green {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN_ONLINE;
+			gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-wan-orange {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_WAN;
+			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-wlan2g {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_2GHZ;
+			gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-wlan5g {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN_5GHZ;
+			gpios = <&tlmm 39 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-usb {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_USB;
+			gpios = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+			trigger-sources = <&usb_port1>;
+			linux,default-trigger = "usbport";
+		};
+	};
+
+	/* vendor "usb_enabled" GPIO - switches the USB port's VBUS rail */
+	reg_usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		/* nothing consumes this supply (the qcom dwc3 glue ignores
+		 * vbus-supply), so keep the rail permanently on */
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+&xo_board_clk {
+	clock-div = <4>;
+	clock-mult = <1>;
+};
+
+&blsp1_uart1 {
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&crypto {
+	status = "okay";
+};
+
+&cryptobam {
+	status = "okay";
+};
+
+&prng {
+	status = "okay";
+};
+
+&qfprom {
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	pinctrl-0 = <&qpic_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+
+		nand-ecc-engine = <&qpic_nand>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		/*
+		 * Layout from the stock firmware device tree (OEM
+		 * "IPQ5018/AP-MP03.3"). Dual rootfs (rootfs / rootfs_1);
+		 * the final OpenWrt flashing layout is handled in stage 3e.
+		 */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x0 0x80000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "0:MIBIB";
+				reg = <0x80000 0x80000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "0:BOOTCONFIG";
+				reg = <0x100000 0x40000>;
+				read-only;
+			};
+
+			partition@140000 {
+				label = "0:BOOTCONFIG1";
+				reg = <0x140000 0x40000>;
+				read-only;
+			};
+
+			partition@180000 {
+				label = "0:QSEE";
+				reg = <0x180000 0x100000>;
+				read-only;
+			};
+
+			partition@280000 {
+				label = "0:DEVCFG";
+				reg = <0x280000 0x40000>;
+				read-only;
+			};
+
+			partition@2c0000 {
+				label = "0:CDT";
+				reg = <0x2c0000 0x40000>;
+				read-only;
+			};
+
+			partition@300000 {
+				label = "0:APPSBLENV";
+				reg = <0x300000 0x80000>;
+			};
+
+			partition@380000 {
+				label = "0:APPSBL";
+				reg = <0x380000 0x140000>;
+				read-only;
+			};
+
+			partition@4c0000 {
+				label = "0:ART";
+				reg = <0x4c0000 0x100000>;
+				read-only;
+			};
+
+			partition@5c0000 {
+				label = "0:TRAINING";
+				reg = <0x5c0000 0x80000>;
+				read-only;
+			};
+
+			partition@640000 {
+				label = "rootfs";
+				reg = <0x640000 0x2a00000>;
+			};
+
+			partition@3040000 {
+				label = "rootfs_1";
+				reg = <0x3040000 0x2a00000>;
+			};
+
+			partition@5a40000 {
+				label = "tp_data";
+				reg = <0x5a40000 0x840000>;
+				read-only;
+			};
+
+			partition@6280000 {
+				label = "radio";
+				reg = <0x6280000 0x440000>;
+				read-only;
+			};
+
+			partition@66c0000 {
+				label = "data";
+				reg = <0x66c0000 0x80000>;
+			};
+		};
+	};
+};
+
+/*
+ * ===========================================================================
+ * Ethernet (kernel 6.12 DWMAC + DSA, all verified on hardware 2026-07-06).
+ *
+ *   IPQ5018 gmac1 -> uniphy0 PCS -> 2.5G HSGMII trunk -> RTL8367S DSA switch
+ *   All FIVE front jacks are RTL8367S internal PHYs:
+ *     blue WAN = phy0 ("wan"), LAN1-4 = phy1-4 ("lan1".."lan4")
+ *   The SoC's internal GE PHY (mdio0:7/gmac0) is NOT bonded out -> disabled.
+ *
+ *   RTL8367S: MDIO addr 29 on mdio1, reset GPIO 33 (the OEM DTS's "GPIO39"
+ *   is wrong/unused). Requires the rtl8365mb SGMII/HSGMII patch (0918);
+ *   no 8051 SerDes firmware needed. Stock runs the trunk at 1G SGMII; 2.5G HSGMII
+ *   verified working with this driver.
+ * ===========================================================================
+ */
+
+/*
+ * The IPQ5018 internal GE PHY (mdio0 addr 7 / gmac0) is NOT wired to any
+ * jack on this board: all five front jacks (blue "WAN" + LAN1-4) hang off
+ * the RTL8367S's five internal PHYs (verified per-jack on hardware, see
+ * the switch ports below). Keep gmac0 disabled.
+ */
+&gmac0 {
+	status = "disabled";
+};
+
+&mdio0 {
+	status = "okay";
+};
+
+/* LAN trunk PCS */
+&uniphy0 {
+	status = "okay";
+};
+
+&gmac1 {
+	status = "okay";
+
+	phy-mode = "2500base-x";
+
+	fixed-link {
+		speed = <2500>;
+		full-duplex;
+	};
+};
+
+&mdio1 {
+	status = "okay";
+
+	pinctrl-0 = <&mdio1_pins>;
+	pinctrl-names = "default";
+	reset-gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
+
+	/*
+	 * RTL8367S (OEM labels it "qca83xx"). MDIO-connected (realtek-mdio).
+	 * reg = 29: confirmed correct (Angel666 working port + forum). The
+	 * switch RESET is GPIO33 (Angel666 "switch = <&tlmm 33 0>" + Sunshainy),
+	 * NOT the OEM-labelled GPIO39 - using 39 left the chip in reset and MDIO
+	 * read back 0xffff ("unrecognized switch").
+	 */
+	switch@29 {
+		compatible = "realtek,rtl8365mb";
+		reg = <29>;
+
+		/*
+		 * The RTL8367S internal user-side MDIO bus. The DSA realtek
+		 * driver (rtl83xx_setup_user_mdio) requires this child node -
+		 * without it probe fails with "no MDIO bus node". LAN1-4 hang
+		 * off the switch's internal PHYs 0-3.
+		 */
+		mdio {
+			compatible = "realtek,smi-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			switchphy0: ethernet-phy@0 {
+				reg = <0>;
+			};
+
+			switchphy1: ethernet-phy@1 {
+				reg = <1>;
+			};
+
+			switchphy2: ethernet-phy@2 {
+				reg = <2>;
+			};
+
+			switchphy3: ethernet-phy@3 {
+				reg = <3>;
+			};
+
+			switchphy4: ethernet-phy@4 {
+				reg = <4>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/*
+			 * Physical jack -> switch PHY map (verified per-jack):
+			 * blue WAN = phy0, LAN1 = phy1, LAN2 = phy2,
+			 * LAN3 = phy3, LAN4 = phy4. The SoC's internal GE PHY
+			 * is not bonded out.
+			 */
+			port@0 {
+				reg = <0>;
+				label = "wan";
+				phy-handle = <&switchphy0>;
+			};
+
+			port@1 {
+				reg = <1>;
+				label = "lan1";
+				phy-handle = <&switchphy1>;
+			};
+
+			port@2 {
+				reg = <2>;
+				label = "lan2";
+				phy-handle = <&switchphy2>;
+			};
+
+			port@3 {
+				reg = <3>;
+				label = "lan3";
+				phy-handle = <&switchphy3>;
+			};
+
+			port@4 {
+				reg = <4>;
+				label = "lan4";
+				phy-handle = <&switchphy4>;
+			};
+
+			port@6 {
+				reg = <6>;
+				label = "cpu";
+				ethernet = <&gmac1>;
+				phy-mode = "2500base-x";
+
+				fixed-link {
+					speed = <2500>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+&usbphy0 {
+	status = "okay";
+};
+
+&soc {
+	/*
+	 * SuperSpeed "uni" PHY (no node in the mainline dtsi - mainline has
+	 * no driver; ours is patch 0922, ported from the QSDK). Layout as in
+	 * the stock DTB ssuniphy@5d000, por_rst = GCC_USB0_PHY_BCR - but on
+	 * top of the vendor's pipe+cfg_ahb the driver also needs aux+lfps:
+	 * with either gated, the 0x5d000 register file hangs the bus (the
+	 * vendor controller node enables them before its phy init).
+	 */
+	ssphy: phy@5d000 {
+		compatible = "qcom,ipq5018-usb-ssphy";
+		reg = <0x0005d000 0x800>;
+
+		clocks = <&gcc GCC_USB0_PIPE_CLK>,
+			 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
+			 <&gcc GCC_USB0_AUX_CLK>,
+			 <&gcc GCC_USB0_LFPS_CLK>;
+		clock-names = "pipe",
+			      "cfg_ahb",
+			      "aux",
+			      "lfps";
+
+		resets = <&gcc GCC_USB0_PHY_BCR>;
+
+		#phy-cells = <0>;
+	};
+};
+
+&usb {
+	status = "okay";
+
+	vbus-supply = <&reg_usb_vbus>;
+
+	/*
+	 * The USB pads are behind a TCSR-controlled phy mux (stock DTB:
+	 * qcom,phy-mux-regs = <syscon@1945000 0x2540>). The same register
+	 * inside the mainline tcsr node (0x1937000) is at offset 0x10540.
+	 * TP-Link's U-Boot never selects the USB position - patch 0921
+	 * writes 1 here at probe.
+	 */
+	qcom,phy-mux-regs = <&tcsr 0x10540>;
+
+	/*
+	 * TP-Link's U-Boot leaves the mock UTMI RCG at 120 MHz; the stock
+	 * DTB assigns the UTMI-spec 60 MHz. Without it the HS side never
+	 * detects a connect.
+	 */
+	assigned-clocks = <&gcc GCC_USB0_MOCK_UTMI_CLK>;
+	assigned-clock-rates = <60000000>;
+
+	/*
+	 * The dtsi is written for HS-only operation (no SS phy driver in
+	 * mainline): it substitutes the UTMI clock for the controller's
+	 * PIPE interface. With the real SS phy up this must go away - the
+	 * combination of a live SS phy and the UTMI substitution hangs the
+	 * controller (verified live: the system dies within minutes even
+	 * with no SS device plugged).
+	 */
+	/delete-property/ qcom,select-utmi-as-pipe-clk;
+};
+
+&usb_dwc {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	dr_mode = "host";
+
+	phys = <&usbphy0>, <&ssphy>;
+	phy-names = "usb2-phy", "usb3-phy";
+
+	usb_port1: port@1 {
+		reg = <1>;
+		#trigger-source-cells = <0>;
+	};
+};
+
+/*
+ * ===========================================================================
+ * Stage 3d - WiFi (IPQ5018 2.4 GHz + QCN6122/QCN6102 5 GHz).
+ * GL-B3000 style: 5 GHz radio on UPD ID 3 (q6_wcss_pd3), no boot-args,
+ * so the (board-specific, unexposed) QCN6122 reset GPIO is not needed.
+ * Per-device pre-cal is pulled from 0:ART by the 11-ath11k-caldata hotplug.
+ * ===========================================================================
+ */
+&q6v5_wcss {
+	status = "okay";
+};
+
+&wifi {
+	status = "okay";
+
+	qcom,rproc = <&q6_wcss_pd1>;
+	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-calibration-variant = "TP-Link-Archer-AX55-v1";
+	qcom,bdf-addr = <0x4c400000>;
+};
+
+&wifi1 {
+	status = "okay";
+
+	qcom,rproc = <&q6_wcss_pd3>;
+	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-calibration-variant = "TP-Link-Archer-AX55-v1";
+	qcom,bdf-addr = <0x4d100000>;
+	qcom,m3-dump-addr = <0x4df00000>;
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio25", "gpio31";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	led_pins: led-state {
+		pins = "gpio10", "gpio11", "gpio13", "gpio18", "gpio22",
+		       "gpio38";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	mdio1_pins: mdio1-state {
+		mdc-pins {
+			pins = "gpio36";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mdio-pins {
+			pins = "gpio37";
+			function = "mdio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	qpic_pins: qpic-state {
+		clock-pins {
+			pins = "gpio9";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		cs-pins {
+			pins = "gpio8";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data-pins {
+			pins = "gpio4", "gpio5", "gpio6", "gpio7";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	serial_0_pins: uart0-state {
+		pins = "gpio20", "gpio21";
+		function = "blsp0_uart0";
+		bias-disable;
+	};
+};
diff --git a/target/linux/qualcommax/files/drivers/net/ethernet/stmicro/stmmac/dwmac-ipq5018.c b/target/linux/qualcommax/files/drivers/net/ethernet/stmicro/stmmac/dwmac-ipq5018.c
new file mode 100644
index 0000000000..78f22e1c8b
--- /dev/null
+++ b/target/linux/qualcommax/files/drivers/net/ethernet/stmicro/stmmac/dwmac-ipq5018.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm IPQ5018 DWMAC glue layer
+ *
+ * Copyright (C) 2026 The OpenWrt Project
+ */
+
+#include <linux/clk.h>
+#include <linux/of_mdio.h>
+#include <linux/pcs/pcs.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/stmmac.h>
+
+#include "stmmac_platform.h"
+
+#define MAX_FRAME_SIZE	16383	/* 14 bits */
+/* MAX_MTU = (MAX_FRAME_SIZE - ETH_HLEN - ETH_FCS_LEN - (2 * VLAN_HLEN)) */
+#define MAX_MTU		16357
+
+static struct clk_bulk_data ipq5018_gmac_clks[] = {
+	{ .id = "stmmaceth" },
+	{ .id = "pclk" },
+	{ .id = "ptp_ref" },
+	{ .id = "ahb" },
+	{ .id = "axi" },
+	{ .id = "rx" },
+	{ .id = "tx" },
+};
+
+struct ipq5018_gmac {
+	struct device *dev;
+	struct clk *rx_clk;
+	struct clk *tx_clk;
+};
+
+static void ipq5018_gmac_fix_speed(void *priv, unsigned int speed, unsigned int mode)
+{
+	struct ipq5018_gmac *gmac = priv;
+	unsigned long rate;
+
+	switch(speed) {
+		case SPEED_10:
+			rate = 2500000;
+			break;
+		case SPEED_100:
+			rate = 25000000;
+			break;
+		case SPEED_1000:
+			rate = 125000000;
+			break;
+		case SPEED_2500:
+			rate = 312500000;
+			break;
+		default:
+			dev_err(gmac->dev, "Unsupported speed: %d\n", speed);
+			rate = 125000000;
+			break;
+	}
+
+	clk_set_rate(gmac->rx_clk, rate);
+	clk_set_rate(gmac->tx_clk, rate);
+}
+
+static int ipq5018_gmac_pcs_init(struct stmmac_priv *priv)
+{
+	struct phylink_pcs *pcs;
+	int ret;
+
+	pcs = fwnode_pcs_get(dev_fwnode(priv->device), 0);
+	if (!pcs)
+		return 0;
+	else if (IS_ERR(pcs)) {
+		ret = PTR_ERR(pcs);
+		if (ret == -ENOENT)
+			return 0;
+		dev_err(priv->device, "failed to parse PCS from fwnode\n");
+		return ret;
+	}
+
+	priv->hw->phylink_pcs = pcs;
+
+	return 0;
+}
+
+static struct phylink_pcs *ipq5018_gmac_select_pcs(struct stmmac_priv *priv,
+						   phy_interface_t interface)
+{
+	switch (interface) {
+	case PHY_INTERFACE_MODE_SGMII:
+	case PHY_INTERFACE_MODE_2500BASEX:
+		if (priv->hw->phylink_pcs)
+			return priv->hw->phylink_pcs;
+	default:
+		break;
+	}
+
+	return NULL;
+}
+
+static void ipq5018_gmac_get_interfaces(struct stmmac_priv *priv, void *bsp_priv,
+				    unsigned long *interfaces)
+{
+	struct mac_device_info *mac = priv->hw;
+
+	/*
+	 * IPQ5018 has two GMACs:
+	 * - GMAC0 supports SGMII and is wired to the SoC's internal GE PHY
+	 * - GMAC1 supports SGMII and 2500BaseX, configurable by the UNIPHY PCS
+	 */
+	__set_bit(PHY_INTERFACE_MODE_SGMII, interfaces);
+	if (priv->hw->phylink_pcs) {
+		__set_bit(PHY_INTERFACE_MODE_2500BASEX, interfaces);
+
+		/* 
+		 * Synopsys DWMAC IP version 3.7 is limited to 1 Gpbs.
+		 * This vendor specific implementation supports 2.5 Gbps, so override
+	 	 * the default mac link capabilities.
+	 	 */
+		mac->link.caps |= MAC_2500FD;
+	}
+}
+
+static int ipq5018_gmac_probe(struct platform_device *pdev)
+{
+	struct plat_stmmacenet_data *plat_dat;
+	struct stmmac_resources stmmac_res;
+	struct device *dev = &pdev->dev;
+	struct ipq5018_gmac *gmac;
+	int ret;
+
+	ret = stmmac_get_platform_resources(pdev, &stmmac_res);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to get stmmac platform resources\n");
+
+	plat_dat = devm_stmmac_probe_config_dt(pdev, stmmac_res.mac);
+	if (IS_ERR_OR_NULL(plat_dat))
+		return dev_err_probe(dev, PTR_ERR(plat_dat),
+				     "failed to parse stmmac dt parameters\n");
+
+	gmac = devm_kzalloc(dev, sizeof(*gmac), GFP_KERNEL);
+	if (!gmac)
+		return dev_err_probe(dev, -ENOMEM,
+				     "failed to allocate priv\n");
+
+	gmac->dev = dev;
+
+	gmac->rx_clk = devm_clk_get(dev, "rx");
+	if (IS_ERR(gmac->rx_clk))
+		return dev_err_probe(dev, PTR_ERR(gmac->rx_clk),
+				     "failed to get RX clock\n");
+
+	gmac->tx_clk = devm_clk_get(dev, "tx");
+	if (IS_ERR(gmac->tx_clk))
+		return dev_err_probe(dev, PTR_ERR(gmac->tx_clk),
+				     "failed to get TX clock\n");
+	
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(ipq5018_gmac_clks),
+				ipq5018_gmac_clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(ipq5018_gmac_clks),
+						 ipq5018_gmac_clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable clocks\n");
+
+	plat_dat->bsp_priv = gmac;
+	plat_dat->max_speed = 2500;
+	plat_dat->maxmtu = MAX_MTU;
+	plat_dat->rx_fifo_size = MAX_FRAME_SIZE;
+	plat_dat->tx_fifo_size = MAX_FRAME_SIZE;
+	plat_dat->get_interfaces = ipq5018_gmac_get_interfaces;
+	plat_dat->fix_mac_speed = ipq5018_gmac_fix_speed;
+	plat_dat->pcs_init = ipq5018_gmac_pcs_init;
+	plat_dat->select_pcs = ipq5018_gmac_select_pcs;
+
+	return stmmac_dvr_probe(dev, plat_dat, &stmmac_res);
+}
+
+static const struct of_device_id ipq5018_gmac_dwmac_match[] = {
+	{ .compatible = "qcom,ipq5018-gmac" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ipq5018_gmac_dwmac_match);
+
+static struct platform_driver ipq5018_gmac_dwmac_driver = {
+	.probe = ipq5018_gmac_probe,
+	.driver = {
+		.name		= "ipq5018-gmac-dwmac",
+		.of_match_table	= ipq5018_gmac_dwmac_match,
+	},
+};
+module_platform_driver(ipq5018_gmac_dwmac_driver);
+
+MODULE_DESCRIPTION("Qualcomm IPQ5018 DWMAC glue layer");
+MODULE_LICENSE("GPL");
