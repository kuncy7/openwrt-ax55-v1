+	{ .compatible = "qualcomm,ipq5018-uniphy", .data = &ipq5018_data },
+	{ .compatible = "qualcomm,ipq6018-uniphy", .data = &ipq6018_data },
+	{ .compatible = "qualcomm,ipq8074-uniphy", .data = &ipq8074_data },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, qca_uniphy_of_match);
+
+static int uniphy_pcs_regmap_read(void *context, unsigned int reg,
+				  unsigned int *val)
+{
+	struct qca_uniphy *uniphy = context;
+
+	/* PCS uses direct AHB access while XPCS uses indirect AHB access */
+	if (reg >= XPCS_INDIRECT_ADDR) {
+		writel(FIELD_GET(XPCS_INDIRECT_ADDR_H, reg),
+		       uniphy->base + XPCS_INDIRECT_AHB_ADDR);
+		*val = readl(uniphy->base + XPCS_INDIRECT_DATA_ADDR(reg));
+	} else {
+		*val = readl(uniphy->base + reg);
+	}
+
+	return 0;
+}
+
+static int uniphy_pcs_regmap_write(void *context, unsigned int reg,
+				   unsigned int val)
+{
+	struct qca_uniphy *uniphy = context;
+
+	/* PCS uses direct AHB access while XPCS uses indirect AHB access */
+	if (reg >= XPCS_INDIRECT_ADDR) {
+		writel(FIELD_GET(XPCS_INDIRECT_ADDR_H, reg),
+		       uniphy->base + XPCS_INDIRECT_AHB_ADDR);
+		writel(val, uniphy->base + XPCS_INDIRECT_DATA_ADDR(reg));
+	} else {
+		writel(val, uniphy->base + reg);
+	}
+
+	return 0;
+}
+
+static struct phylink_pcs *qca_uniphy_get(struct fwnode_reference_args *pcsspec,
+					  void *data)
+{
+	struct qca_uniphy *uniphy = data;
+	struct device *dev = uniphy->dev;
+	int channel = 0;
+
+	if (pcsspec->nargs > 1) {
+		dev_err(dev, "Invalid number of cells in 'pcs-handle' property\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	if (pcsspec->nargs)
+		channel = pcsspec->args[0];
+
+	if (channel >= QCA_UNIPHY_CHANNELS) {
+		dev_err(dev, "Invalid channel in 'pcs-handle' property\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	return &uniphy->port_pcs[channel].pcs;
+}
+
+static const struct regmap_config uniphy_regmap_cfg = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_read = uniphy_pcs_regmap_read,
+	.reg_write = uniphy_pcs_regmap_write,
+	.fast_io = true,
+};
+
+static int qca_uniphy_probe(struct platform_device *pdev)
+{
+	struct fwnode_pcs_provider *provider;
+	struct device *dev = &pdev->dev;
+	struct clk_bulk_data *clks;
+	struct qca_uniphy *uniphy;
+	int ret, i, num_clks;
+
+	uniphy = devm_kzalloc(dev, sizeof(*uniphy), GFP_KERNEL);
+	if (!uniphy)
+		return -ENOMEM;
+
+	uniphy->dev = dev;
+
+	uniphy->data = device_get_match_data(dev);
+	if (!uniphy->data)
+		return -EINVAL;
+
+	uniphy->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(uniphy->base))
+		return dev_err_probe(dev, PTR_ERR(uniphy->base),
+				     "Failed to ioremap resource");
+
+	uniphy->regmap = devm_regmap_init(dev, NULL, uniphy, &uniphy_regmap_cfg);
+	if (IS_ERR(uniphy->regmap))
+		return dev_err_probe(dev, PTR_ERR(uniphy->regmap),
+				     "Failed to init regmap");
+
+	uniphy->rst_soft = devm_reset_control_get_exclusive(dev, "soft");
+	if (IS_ERR(uniphy->rst_soft))
+		return dev_err_probe(dev, PTR_ERR(uniphy->rst_soft),
+				     "Failed to get soft reset\n");
+
+	uniphy->rst_xpcs = devm_reset_control_get_optional_exclusive(dev, "xpcs");
+	if (IS_ERR(uniphy->rst_xpcs))
+		return dev_err_probe(dev, PTR_ERR(uniphy->rst_xpcs),
+				     "Failed to get xpcs reset\n");
+
+	num_clks = devm_clk_bulk_get_all_enabled(dev, &clks);
+	if (num_clks < 0)
+		return dev_err_probe(dev, num_clks, "Failed to get clocks\n");
+
+	uniphy->clks = clks;
+	uniphy->num_clks = num_clks;
+
+	ret = qca_uniphy_register_clks(uniphy);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to register output clocks\n");
+
+	for (i = 0; i < QCA_UNIPHY_CHANNELS; i++) {
+		uniphy->port_pcs[i].pcs.ops = &qca_uniphy_pcs_ops;
+		uniphy->port_pcs[i].pcs.neg_mode = true;
+		uniphy->port_pcs[i].pcs.poll = true;
+		uniphy->port_pcs[i].uniphy = uniphy;
+		uniphy->port_pcs[i].channel = i;
+	}
+
+	platform_set_drvdata(pdev, uniphy);
+
+	provider = devm_fwnode_pcs_add_provider(dev, dev_fwnode(dev),
+						qca_uniphy_get, uniphy);
+	if (IS_ERR(provider))
+		return dev_err_probe(dev, PTR_ERR(provider), "Failed to add PCS provider\n");
+
+	return 0;
+}
+
+static struct platform_driver qca_uniphy_driver = {
+	.driver = {
+		.name			= "qca-uniphy",
+		.suppress_bind_attrs	= true,
+		.of_match_table		= qca_uniphy_of_match,
+	},
+	.probe = qca_uniphy_probe,
+};
+module_platform_driver(qca_uniphy_driver);
+
+MODULE_DESCRIPTION("Qualcomm IPQ6018 UNIPHY PCS driver");
+MODULE_LICENSE("GPL");
diff --git a/target/linux/qualcommax/files/include/dt-bindings/net/pcs/qualcomm,ipq-uniphy.yaml b/target/linux/qualcommax/files/include/dt-bindings/net/pcs/qualcomm,ipq-uniphy.yaml
new file mode 100644
index 0000000000..3548cb51ad
--- /dev/null
+++ b/target/linux/qualcommax/files/include/dt-bindings/net/pcs/qualcomm,ipq-uniphy.yaml
@@ -0,0 +1,208 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/pcs/qualcomm,ipq-uniphy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm IPQ UNIPHY PCS
+
+maintainers:
+  - John Crispin <john@phrozen.org>
+  - Christian Marangi <ansuelsmth@gmail.com>
+
+description: |
+  The UNIPHY blocks found in Qualcomm IPQ AX and BE SoCs provide SerDes-based
+  Physical Coding Sublayer (PCS) controllers. Each SoC contains one or multiple
+  UNIPHY instances. An instance can operate in PSGMII mode or in single-channel
+  mode (SGMII, 2500BASE-X, USXGMII). The PPE DSA switch driver references
+  UNIPHY instances through pcs-handle phandles.
+
+properties:
+  compatible:
+    enum:
+      - qualcomm,ipq5018-uniphy
+      - qualcomm,ipq6018-uniphy
+      - qualcomm,ipq8074-uniphy
+
+  reg:
+    maxItems: 1
+
+  '#pcs-cells':
+    const: 1
+    description:
+      The single cell specifies the channel index within the UNIPHY instance.
+
+  clocks:
+    minItems: 4
+    maxItems: 12
+    description: |
+      Core clocks (AHB, SYS) are always required. Per-channel RX/TX clock
+      pairs are provided for each port the UNIPHY instance serves. Instances
+      serving a single port have 4 clocks, PSGMII instances serving 5 ports
+      have 12. The CMN PLL CC provides a 50MHz reference clock to the UNIPHY
+      PCS which gates and divides it to pass through either a 25 MHz or 50 MHz
+      clock to an attached Ethernet PHY or a switch.
+    items:
+        - description: ahb clock
+        - description: sys clock
+        - description: port1_rx or port5_rx or port6_rx clock
+        - description: port1_tx or port5_tx or port6_tx clock
+        - description: port2_rx clock
+        - description: port2_tx clock
+        - description: port3_rx clock
+        - description: port3_tx clock
+        - description: port4_rx clock
+        - description: port4_tx clock
+        - description: port5_rx clock
+        - description: port5_tx clock
+        - description: CMN PLL reference clock
+
+  clock-names:
+    minItems: 4
+    maxItems: 12
+    items:
+        - const: ahb
+        - const: sys
+        - enum: [port1_rx, port5_rx, port6_rx]
+        - enum: [port1_tx, port5_tx, port6_tx]
+        - const: port2_rx
+        - const: port2_tx
+        - const: port3_rx
+        - const: port3_tx
+        - const: port4_rx
+        - const: port4_tx
+        - const: port5_rx
+        - const: port5_tx
+        - const: ref
+
+  clock-output-names:
+    description: Name of the uniphy GCC clock for TX and RX.
+    items:
+      - enum:
+          - uniphy0_gcc_tx_clk
+          - uniphy1_gcc_tx_clk
+          - uniphy2_gcc_tx_clk
+      - enum:
+          - uniphy0_gcc_rx_clk
+          - uniphy1_gcc_rx_clk
+          - uniphy2_gcc_rx_clk
+      - const: uniphy0_ref_clk
+
+  '#clock-cells':
+    const: 1
+
+  resets:
+    minItems: 1
+    items:
+      - description: soft reset
+      - description: xpcs reset
+
+  reset-names:
+    minItems: 1
+    items:
+      - const: soft
+      - const: xpcs
+
+required:
+  - compatible
+  - reg
+  - '#pcs-cells'
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,gcc-ipq8074.h>
+    #include <dt-bindings/net/qca-uniphy.h>
+
+    ethernet-pcs@7a10000 {
+        compatible = "qualcomm,ipq8074-uniphy";
+        reg = <0x7a10000 0x10000>;
+
+        clocks = <&gcc GCC_UNIPHY1_AHB_CLK>,
+                 <&gcc GCC_UNIPHY1_SYS_CLK>,
+                 <&gcc GCC_UNIPHY1_PORT5_RX_CLK>,
+                 <&gcc GCC_UNIPHY1_PORT5_TX_CLK>;
+        clock-names = "ahb", "sys",
+                      "port5_rx", "port5_tx";
+
+        clock-output-names = "uniphy1_gcc_tx_clk",
+                             "uniphy1_gcc_rx_clk";
+
+        resets = <&gcc GCC_UNIPHY1_SOFT_RESET>,
+                 <&gcc GCC_UNIPHY1_XPCS_RESET>;
+        reset-names = "soft", "xpcs";
+
+        #pcs-cells = <1>;
+    };
+
+  - |
+    #include <dt-bindings/clock/qcom,gcc-ipq6018.h>
+    #include <dt-bindings/net/qca-uniphy.h>
+
+    ethernet-pcs@7a00000 {
+        compatible = "qualcomm,ipq6018-uniphy";
+        reg = <0x7a00000 0x10000>;
+        qcom,psgmii;
+
+        clocks = <&gcc GCC_UNIPHY0_AHB_CLK>,
+                 <&gcc GCC_UNIPHY0_SYS_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT1_RX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT1_TX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT2_RX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT2_TX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT3_RX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT3_TX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT4_RX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT4_TX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT5_RX_CLK>,
+                 <&gcc GCC_UNIPHY0_PORT5_TX_CLK>;
+        clock-names = "ahb", "sys",
+                      "port1_rx", "port1_tx",
+                      "port2_rx", "port2_tx",
+                      "port3_rx", "port3_tx",
+                      "port4_rx", "port4_tx",
+                      "port5_rx", "port5_tx";
+
+        clock-output-names = "uniphy0_gcc_tx_clk",
+                             "uniphy0_gcc_rx_clk";
+
+        resets = <&gcc GCC_UNIPHY0_SOFT_RESET>,
+                 <&gcc GCC_UNIPHY0_XPCS_RESET>;
+        reset-names = "soft", "xpcs";
+
+        #pcs-cells = <1>;
+    };
+
+  - |
+    #include <dt-bindings/clock/qcom,gcc-ipq5018.h>
+    #include <dt-bindings/net/qca-uniphy.h>
+
+    ethernet-pcs@98000 {
+        compatible = "qualcomm,ipq5018-uniphy";
+        reg = <0x00098000 0x800>;
+        #clock-cells = <1>;
+        clocks = <&gcc GCC_UNIPHY_AHB_CLK>,
+                 <&gcc GCC_UNIPHY_SYS_CLK>,
+                 <&gcc GCC_UNIPHY_RX_CLK>,
+                 <&gcc GCC_UNIPHY_TX_CLK>,
+                 <&cmn_pll IPQ5018_ETH_50MHZ_CLK>;
+        clock-names = "ahb",
+                      "sys",
+                      "port5_rx",
+                      "port5_tx",
+                      "ref";
+        assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
+        assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
+        clock-output-names = "uniphy0_gcc_rx_clk",
+                             "uniphy0_gcc_tx_clk",
+                             "uniphy0_ref_clk";
+        resets = <&gcc GCC_UNIPHY_SOFT_RESET>;
+        reset-names = "soft";
+
+        #pcs-cells = <0>;
+    };
diff --git a/target/linux/qualcommax/files/include/dt-bindings/net/qca-uniphy.h b/target/linux/qualcommax/files/include/dt-bindings/net/qca-uniphy.h
