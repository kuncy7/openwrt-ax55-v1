++/*
++ * SerDes "babysitter", run from the CPU port's periodic MIB poll. The
++ * vendor's 8051 firmware (which this driver does not load) polls the SDS
++ * status in a loop and re-kicks the SerDes when it is out of sync; a
++ * cold-booted switch occasionally comes out of calibration with a
++ * receiver that never locks - or worse, one that reports lock on the SDS
++ * status register while delivering nothing but FCS-error garbage (every
++ * frame from the SoC counted as dot3StatsFCSErrors, zero good frames).
++ * Trust the data path, not just the status bit: the MIB poll that runs
++ * right before us already fetched the CPU port's cumulative FCS-error
++ * and good-frame counters, so compare them against the previous poll.
++ * On a bad poll, pulse the vendor SerDes reset (rtl8367c_sdsReset():
++ * SDS reg 0x0000 = 0x1401, then 0x1403); if the pulses don't help,
++ * escalate to a full SerDes re-configuration.
++ */
++static void rtl8365mb_ext_sgmii_nanny(struct realtek_priv *priv, int port)
++{
++	struct rtl8365mb *mb = priv->chip_data;
++	struct rtnl_link_stats64 *stats = &mb->ports[port].stats;
++	struct rtnl_link_stats64 conduit_stats;
++	const struct net_device *conduit;
++	u64 crc, pkts, seen, conduit_tx, tx_delta, seen_delta;
++	bool locked, garbage, lossy = false;
++	int ret;
++
++	spin_lock(&mb->ports[port].stats_lock);
++	crc = stats->rx_crc_errors;
++	pkts = stats->rx_packets;
++	seen = stats->rx_packets + stats->rx_errors + stats->rx_dropped;
++	spin_unlock(&mb->ports[port].stats_lock);
++
++	/* All new ingress frames on the trunk were FCS garbage */
++	garbage = crc > mb->sds_last_crc && pkts == mb->sds_last_rx;
++	mb->sds_last_crc = crc;
++	mb->sds_last_rx = pkts;
++
++	/*
++	 * The SerDes can also degrade to silently swallowing most frames:
++	 * no FCS errors, no fragments, the frames just never arrive (seen
++	 * on hardware as ~1 in 40 getting through while the SDS status
++	 * still reports lock). Passive port counters can't see that, so
++	 * compare against the other end of the trunk: everything the DSA
++	 * conduit transmits must show up on the CPU port as *something*
++	 * (a good frame or a counted error).
++	 */
++	conduit = dsa_to_port(&priv->ds, port)->conduit;
++	if (conduit) {
++		dev_get_stats((struct net_device *)conduit, &conduit_stats);
++		conduit_tx = conduit_stats.tx_packets;
++		tx_delta = conduit_tx - mb->sds_last_conduit_tx;
++		seen_delta = seen - mb->sds_last_seen;
++		if (mb->sds_last_conduit_tx && tx_delta >= 16 &&
++		    seen_delta * 4 < tx_delta)
++			lossy = true;
++		mb->sds_last_conduit_tx = conduit_tx;
++		mb->sds_last_seen = seen;
++	}
++
++	ret = rtl8365mb_ext_sgmii_rx_locked(priv, &locked);
++	if (ret)
++		return;
++
++	if (locked && !garbage && !lossy) {
++		if (mb->sds_pulses || mb->sds_bad_polls)
++			dev_info(priv->dev,
++				 "port %d SerDes healthy after %d reset pulse(s)\n",
++				 port, mb->sds_pulses);
++		mb->sds_pulses = 0;
++		mb->sds_bad_polls = 0;
++		return;
++	}
++
++	if ((garbage || lossy) && ++mb->sds_bad_polls >= 3) {
++		dev_warn(priv->dev,
++			 "port %d SerDes %s despite %s - re-running SerDes config\n",
++			 port, garbage ? "delivers FCS garbage" : "silently drops frames",
++			 locked ? "reporting lock" : "reset pulses");
++		ret = rtl8365mb_ext_config_sgmii(priv, port,
++						 mb->sds_interface);
++		if (ret)
++			dev_err(priv->dev,
++				"port %d SerDes re-config failed: %pe\n",
++				port, ERR_PTR(ret));
++		mb->sds_bad_polls = 0;
++		mb->sds_pulses = 0;
++		return;
++	}
++
++	ret = rtl8365mb_sds_indacs_write(priv, 0x1401, 0x0000);
++	if (!ret)
++		ret = rtl8365mb_sds_indacs_write(priv, 0x1403, 0x0000);
++	if (ret)
++		return;
++
++	if (++mb->sds_pulses == 10)
++		dev_warn(priv->dev,
++			 "port %d SerDes RX still not locked after %d reset pulses\n",
++			 port, mb->sds_pulses);
++}
++
+ static void rtl8365mb_phylink_get_caps(struct dsa_switch *ds, int port,
+ 				       struct phylink_config *config)
