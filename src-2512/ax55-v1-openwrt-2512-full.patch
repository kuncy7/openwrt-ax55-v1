diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/09_mount_tp_data b/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/09_mount_tp_data
new file mode 100644
index 0000000000..abb34b996c
--- /dev/null
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/09_mount_tp_data
@@ -0,0 +1,27 @@
+#!/bin/sh
+# The TP-Link Archer AX55 v1 keeps its factory data (including the 6-byte
+# "default-mac") in the tp_data UBIFS volume. Attach and mount it read-only
+# during preinit so board.d/02_network and the ath11k caldata hotplug can
+# read the MAC without each attaching the volume themselves.
+
+. /lib/functions.sh
+
+preinit_mount_tp_data() {
+	[ "$(board_name)" = "tplink,archer-ax55-v1" ] || return
+
+	# ubiattach lives in /usr/sbin, which the preinit PATH omits
+	local PATH="/usr/sbin:/usr/bin:$PATH"
+	local mtd_num ubi_num
+
+	mtd_num=$(find_mtd_index tp_data)
+	[ -n "$mtd_num" ] || return
+
+	ubi_num=$(ubiattach -m "$mtd_num" 2>/dev/null | \
+		sed -n 's/.*device number \([0-9]*\).*/\1/p')
+	[ -n "$ubi_num" ] || return
+
+	mkdir -p /tmp/tp_data
+	mount -t ubifs -o ro "ubi${ubi_num}:tp_data" /tmp/tp_data 2>/dev/null
+}
+
+boot_hook_add preinit_main preinit_mount_tp_data
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
index 9be1d8211c..bd36692a5a 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
@@ -199,6 +199,29 @@ platform_do_upgrade() {
 	glinet,gl-b3000)
 		glinet_do_upgrade "$1"
 		;;
+	tplink,archer-ax55-v1)
+		# Dual boot: install into the inactive rootfs/rootfs_1 slot,
+		# then point tp_boot_idx at it. The running slot is left
+		# untouched as a fallback - if the new image fails to load,
+		# TP-Link's U-Boot boots the other slot on its own (only on
+		# load failure though: there is no boot counter, a kernel
+		# that boots and then crashes is not detected).
+		local idx=1
+		CI_UBIPART="rootfs_1"
