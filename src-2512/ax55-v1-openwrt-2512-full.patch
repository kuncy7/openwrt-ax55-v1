++struct phylink_pcs *
++fwnode_phylink_pcs_get_from_fwnode(struct fwnode_handle *fwnode,
++				   struct fwnode_handle *pcs_fwnode)
++{
++	struct fwnode_reference_args pcsspec;
++	int i = 0;
++	int ret;
++
++	while (true) {
++		ret = fwnode_parse_pcsspec(fwnode, i, NULL, &pcsspec);
++		if (ret)
++			break;
